                      text_color=TEXT, command=d.destroy).pack(side="right", padx=20)
        ctk.CTkFrame(d, height=1, fg_color=LINE, corner_radius=0).pack(fill="x")
        nav = ctk.CTkFrame(d, width=240, fg_color=PANEL, corner_radius=0)
