        ctk.CTkLabel(mid, text=short(h["description"], 150), text_color=MUTED, anchor="w", justify="left",
                     wraplength=430).pack(anchor="w", pady=(2, 6))
        chips = ctk.CTkFrame(mid, fg_color="transparent")
