    def popup_menu(self, anchor, items, align="right"):
        """Small dropdown under `anchor`. items: (icon kind, label, command)."""
        self.close_menu()
        m = self._menu = ctk.CTkFrame(self, fg_color=PANEL, corner_radius=12, border_width=1, border_color=LINE)
        for i, (kind, label, cmd) in enumerate(items):
            danger = kind == "trash"
            col = "#FF6B6B" if danger else TEXT
            ctk.CTkButton(m, text="  " + label, image=make_icon(kind, col, 16), compound="left", anchor="w",
                          width=190, height=38, corner_radius=8, fg_color="transparent", hover_color=LINE,
                          text_color=col, font=(FONT, 13, "bold"),
                          command=lambda c=cmd: (self.close_menu(), c())).pack(padx=6, pady=(6 if i == 0 else 0, 6))
        s = ctk.ScalingTracker.get_widget_scaling(self)
        self.update_idletasks()
        x = (anchor.winfo_rootx() - self.winfo_rootx()) / s
        if align == "right":
            x = x + anchor.winfo_width() / s - m.winfo_reqwidth() / s
        y = (anchor.winfo_rooty() - self.winfo_rooty() + anchor.winfo_height()) / s + 6
        m.place(x=max(8, x), y=y)
        m.lift()

    def confirm_delete(self, p):
        self.notice(f"Delete {short(p['name'], 24)}?",
                    "It will be removed from Alpha. Its game folder stays on your PC, so worlds and "
                    "screenshots are not lost.", [("Delete", lambda: self.delete(p), False)], close="Cancel")

    # ---------- instance icon: menu + editor ----------
    def close_menu(self, e=None):
        m = getattr(self, "_menu", None)
        if m is None or not m.winfo_exists():
            return
        if e is not None and str(e.widget).startswith(str(m)):
            return  # click inside the menu: let its button handle it
        m.destroy()
        self._menu = None

    def icon_menu(self, p, anchor):
        self.close_menu()
        m = self._menu = ctk.CTkFrame(self, fg_color=PANEL, corner_radius=12, border_width=1, border_color=LINE)
        items = [("upload", "Replace icon", lambda: self.replace_icon(p)),
                 ("palette", "Edit icon", lambda: self.icon_editor(p))]
        if p.get("icon"):
            items.append(("trash", "Remove icon", lambda: self.remove_icon(p)))
        for kind, label, cmd in items:
            ctk.CTkButton(m, text="  " + label, image=make_icon(kind, TEXT, 16), compound="left", anchor="w",
                          width=190, height=38, corner_radius=8, fg_color="transparent", hover_color=LINE,
                          text_color=TEXT, font=(FONT, 13, "bold"),
                          command=lambda c=cmd: (self.close_menu(), c())).pack(padx=6, pady=(6 if kind == "upload" else 0, 6))
        s = ctk.ScalingTracker.get_widget_scaling(self)
        x = (anchor.winfo_rootx() - self.winfo_rootx()) / s
        y = (anchor.winfo_rooty() - self.winfo_rooty() + anchor.winfo_height()) / s + 6
        m.place(x=x, y=y)
        m.lift()

    def _icon_changed(self, p):
        save_json(PROFILES_FILE, self.profiles)
        self.build_rail()
        self._navigating = True
        try:
            self.show_instance(p)
        finally:
            self._navigating = False

    def replace_icon(self, p):
        from tkinter import filedialog
        path = filedialog.askopenfilename(title="Choose an icon image",
                                          filetypes=[("Images", "*.png *.jpg *.jpeg *.webp *.gif *.bmp")])
        if not path:
            return
        try:
            im = Image.open(path).convert("RGBA")
            side = min(im.size)
            im = im.crop(((im.width - side) // 2, (im.height - side) // 2,
                          (im.width + side) // 2, (im.height + side) // 2)).resize((256, 256), Image.LANCZOS)
            g = self.game_dir(p)
            g.mkdir(parents=True, exist_ok=True)
            im.save(g / "alpha_icon.png")
        except Exception as e:
            self.notice("Couldn't use that image", str(e))
            return
        p["icon"] = {"file": "alpha_icon.png", "v": int(time.time())}  # v makes the cache pick up the new file
        self._icon_changed(p)

    def remove_icon(self, p):
        spec = p.pop("icon", None)
        if spec and spec.get("file"):
            (self.game_dir(p) / spec["file"]).unlink(missing_ok=True)
        self._icon_changed(p)

