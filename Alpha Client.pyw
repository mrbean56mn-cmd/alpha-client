        icons = {"Appearance": "🎨", "Behavior": "⚙", "Profile": "👤", "Java and memory": "☕",
                 "Window": "🪟", "Resources": "📊", "Troubleshooting": "🔧"}
        sections = [("DISPLAY", ["Appearance", "Behavior"]), ("ACCOUNT", ["Profile"]),
                    ("INSTANCE DEFAULTS", ["Java and memory", "Window"]), ("SYSTEM", ["Resources", "Troubleshooting"])]
        buttons = {}

        def select(name):
            for n, b in buttons.items():
                on = n == name
                b.configure(fg_color=mix(PANEL, ACCENT, .22) if on else "transparent", text_color=ACCENT if on else TEXT)
            for w in content.winfo_children():
