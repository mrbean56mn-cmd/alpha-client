def symbol_image(name):
    """32x32 symbol with a dark outline and a soft drop shadow."""
    if name not in _SYM_CACHE:
        im = _draw_cube(name) if name in _CUBES else _draw_item(name)
        grown = im.getchannel("A").point(lambda v: 255 if v else 0).filter(ImageFilter.MaxFilter(3))
        outline = Image.new("RGBA", im.size, (22, 24, 30, 255))
        outline.putalpha(grown)
        shadow = Image.new("RGBA", im.size, (0, 0, 0, 0))
        shadow.putalpha(grown.point(lambda v: 80 if v else 0))
        out = Image.new("RGBA", (32, 32), (0, 0, 0, 0))
        out.alpha_composite(shadow, (1, 2))
        out.alpha_composite(outline)
        out.alpha_composite(im)
        _SYM_CACHE[name] = out
    return _SYM_CACHE[name]


def _rounded(im, S):
    mask = Image.new("L", (S, S), 0)
    ImageDraw.Draw(mask).rounded_rectangle([0, 0, S - 1, S - 1], radius=int(S * 0.24), fill=255)
    out = Image.new("RGBA", (S, S), (0, 0, 0, 0))
    out.paste(im, (0, 0), mask)
    return out


def render_icon(spec, S, gdir=None):
    """spec = {"bg": index, "sym": name} or {"file": name-in-instance-folder}. Returns an SxS RGBA image."""
    key = (json.dumps(spec, sort_keys=True), S, str(gdir))
    if key in _ICON_RENDER_CACHE:
        return _ICON_RENDER_CACHE[key]
    if spec.get("file"):
        try:
            src = Image.open(Path(gdir) / spec["file"]).convert("RGBA")
        except Exception:
            return None
        side = min(src.size)
        src = src.crop(((src.width - side) // 2, (src.height - side) // 2,
                        (src.width + side) // 2, (src.height + side) // 2)).resize((S, S), Image.LANCZOS)
        out = _rounded(src, S)
    else:
        _, a, b = ICON_BGS[spec.get("bg", 0) % len(ICON_BGS)]
        a, b = _rgb(a), _rgb(b)
        grad = Image.new("RGBA", (S, S))
        gd = ImageDraw.Draw(grad)
        for y in range(S):
            t = y / max(1, S - 1)
            gd.line([(0, y), (S, y)], fill=tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3)) + (255,))
        out = _rounded(grad, S)
        if spec.get("sym") in ICON_SYMBOLS:
            n = int(S * 0.74)
            sym = symbol_image(spec["sym"]).resize((n, n), Image.NEAREST)
            out.alpha_composite(sym, ((S - n) // 2, (S - n) // 2 - S // 40))
    _ICON_RENDER_CACHE[key] = out
    return out


def skin_preview(png, slim=False, scale=8):
    """Front view of a Minecraft skin file (64x64 or legacy 64x32), drawn pixel-perfect. Returns RGBA or None."""
    try:
        sk = Image.open(io.BytesIO(png)).convert("RGBA")
    except Exception:
        return None
    legacy = sk.height == 32
    aw = 3 if slim else 4
    out = Image.new("RGBA", (16, 32), (0, 0, 0, 0))

    def part(box, at, overlay=None, mirror=False):
        im = sk.crop(box)
        if mirror:
            im = im.transpose(Image.FLIP_LEFT_RIGHT)
        out.alpha_composite(im, at)
        if overlay and not legacy:
            out.alpha_composite(sk.crop(overlay), at)

    part((8, 8, 16, 16), (4, 0), (40, 8, 48, 16))                         # head + hat
    part((20, 20, 28, 32), (4, 8), (20, 36, 28, 48))                      # body + jacket
    part((44, 20, 44 + aw, 32), (4 - aw, 8), (44, 36, 44 + aw, 48))       # right arm (viewer's left)
    part((4, 20, 8, 32), (4, 20), (4, 36, 8, 48))                         # right leg
    if legacy:  # 64x32 skins reuse the right limbs, mirrored
        part((44, 20, 48, 32), (12, 8), mirror=True)
        part((4, 20, 8, 32), (8, 20), mirror=True)
    else:
        part((36, 52, 36 + aw, 64), (12, 8), (52, 52, 52 + aw, 64))      # left arm
        part((20, 52, 24, 64), (8, 20), (4, 52, 8, 64))                   # left leg
    return out.resize((16 * scale, 32 * scale), Image.NEAREST)


def _m(cat, title, desc, kind, data):
    return {"cat": cat, "title": title, "desc": desc, "kind": kind, "data": data}


