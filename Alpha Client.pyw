        self.bind_click(picker, open_pop)

        def loaded():
            if not picker.winfo_exists():
                return
            st["fabric"] = self._fabric_versions
            if self._versions:
                fab = st["fabric"]  # default to the newest release Fabric supports
                st["version"] = next((v for v in self._versions if fab is None or v["id"] in fab), self._versions[0])
            else:
                ver_lbl.configure(text="Couldn't load versions", text_color=MUTED)
            refresh()

        self.load_versions(lambda: self.after(0, loaded))
        refresh()

        def create():
            v = st["version"]
            if v is None:
                return
            p = {"id": uuid.uuid4().hex[:8], "name": name.get().strip() or f"{st['loader'].title()} {v['id']}",
                 "version": v["id"], "loader": st["loader"], "ram": int(ram.get()), "installed": False,
                 "pack": st["loader"] == "fabric" and bool(pack.get())}
            self.profiles.append(p)
            save_json(PROFILES_FILE, self.profiles)
            d.destroy()
            self.build_rail()
            self.show_browse(p) if p["loader"] == "fabric" else self.show_instance(p)

    def hover_row(self, row, base):
        def enter(_):
            row.configure(fg_color=LINE)

        def leave(_):
            x, y = row.winfo_pointerxy()
            rx, ry = row.winfo_rootx(), row.winfo_rooty()
            if not (rx <= x < rx + row.winfo_width() and ry <= y < ry + row.winfo_height()):
                row.configure(fg_color="transparent")

        for w in [row, *row.winfo_children()]:
            w.bind("<Enter>", enter)
        row.bind("<Leave>", leave)

    def load_versions(self, done):
        """Fetch the Minecraft release list and Fabric's supported versions once, in the background."""
        if self._versions is not None:
            done()
            return

        def work():
            try:
                vs = [v for v in mll.utils.get_version_list() if v["type"] == "release"]
                out = []
                for i, v in enumerate(vs):
                    t = v.get("releaseTime")
                    out.append({"id": v["id"], "latest": i == 0, "date": t.strftime("%b %Y") if t else ""})
                self._versions = out
            except Exception:
                self._versions = None  # retry next time
            try:
                r = requests.get("https://meta.fabricmc.net/v2/versions/game", headers=HEADERS, timeout=10)
                self._fabric_versions = {x["version"] for x in r.json()}
            except Exception:
                self._fabric_versions = None
            done()

        threading.Thread(target=work, daemon=True).start()

    def set_remote_icon(self, label, url, size=44):
        if not url:
            return

        def work():
            try:
                if url not in self.icon_cache:
                    data = requests.get(url, headers=HEADERS, timeout=10).content
                    self.icon_cache[url] = Image.open(io.BytesIO(data)).convert("RGBA")
                src = self.icon_cache[url]
                big = size * 2  # rounded corners, drawn at 2x so they stay smooth
                im = _rounded(src.resize((big, big), Image.NEAREST if src.width <= 32 else Image.LANCZOS), big)
                img = ctk.CTkImage(light_image=im, dark_image=im, size=(size, size))
                self.after(0, lambda: label.winfo_exists() and label.configure(image=img, text="",
                                                                               fg_color="transparent"))
            except Exception:
                pass

        self.pool.submit(work)

