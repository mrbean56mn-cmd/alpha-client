    def add_to_instance(self, h, ptype):
        """Pick which instance gets this mod / resource pack / shader."""
        fits = [q for q in self.profiles if ptype != "mod" or q["loader"] == "fabric"]
        d = Dialog(self, 480, 520)
        self.dialog_header(d, "Add to an instance")
        ctk.CTkLabel(d, text=f"Choose where to install {short(h['title'], 32)}.", text_color=MUTED
                     ).pack(anchor="w", padx=26, pady=(16, 8))
        lst = ctk.CTkScrollableFrame(d, fg_color="transparent")
        lst.pack(fill="both", expand=True, padx=16, pady=(0, 16))
        if not fits:
            ctk.CTkLabel(lst, text="You don't have a Fabric instance yet. Create one first." if ptype == "mod"
                         else "You don't have any instances yet.", text_color=MUTED).pack(pady=30)
        for q in fits:
            r = ctk.CTkFrame(lst, fg_color=CARD, corner_radius=12)
            r.pack(fill="x", pady=3)
            self.icon(r, q, 40).pack(side="left", padx=10, pady=8)
            info = ctk.CTkFrame(r, fg_color="transparent")
            info.pack(side="left", fill="x", expand=True)
            ctk.CTkLabel(info, text=short(q["name"], 26), font=(FONT, 14, "bold"), anchor="w").pack(anchor="w")
            ctk.CTkLabel(info, text=f"{q['loader'].title()} {q['version']}", text_color=MUTED, anchor="w",
                         font=(FONT, 12)).pack(anchor="w")
            b = self.btn(r, "Install", None, width=90, height=34)
            b.configure(command=lambda b=b, q=q: self._install_into(b, h, ptype, q))
            b.pack(side="right", padx=10)

    def _install_into(self, b, h, ptype, q):
        b.configure(text="Installing…", state="disabled")

        def work():
            try:
                f = install_project(h["slug"], ptype, q["version"], self.game_dir(q))
                txt = "✓ Added" if f else "No build"
                self.say(f"Added {h['title']} to {q['name']}" if f else
                         f"{h['title']} has no version for Minecraft {q['version']}")
            except Exception as e:
                txt = "Retry"
                self.say(f"Error: {e}")
            self.after(0, lambda: b.winfo_exists() and b.configure(text=txt, state="normal" if txt == "Retry" else "disabled"))

        threading.Thread(target=work, daemon=True).start()

    def _browse_controls(self, pg, tabs):
        """Tabs, search box, sort / view menus and the pager, shared by Browse content and Discover."""
        tabbar = ctk.CTkFrame(pg, fg_color=PANEL, corner_radius=14)
        tabbar.pack(anchor="w", padx=20, pady=(12, 8))
        self.btabs = {}
        for t in tabs:
            b = ctk.CTkButton(tabbar, text=t, height=34, width=60, corner_radius=11, font=(FONT, 13, "bold"),
                              command=lambda t=t: self.browse_tab(t))
            b.pack(side="left", padx=4, pady=4)
            self.btabs[t] = b

        box = ctk.CTkFrame(pg, fg_color=CARD, corner_radius=12, border_width=1, border_color=LINE, height=46)
        box.pack(fill="x", padx=20, pady=(2, 8))
        box.pack_propagate(False)
        ctk.CTkLabel(box, text="", image=make_icon("search", MUTED, 17)).pack(side="left", padx=(14, 4))
        self.bq = ctk.CTkEntry(box, height=40, fg_color=CARD, border_width=0, font=(FONT, 14))
        self.bq.pack(side="left", fill="x", expand=True, padx=(0, 8))
        self._bq_job = None

        def typed(_):
            if self._bq_job:
                self.after_cancel(self._bq_job)
            self._bq_job = self.after(350, lambda: self.browse_go(0))  # search as you type

        self.bq.bind("<KeyRelease>", typed)
        self.bq.bind("<Return>", lambda e: self.browse_go(0))

        row = ctk.CTkFrame(pg, fg_color="transparent")
        row.pack(fill="x", padx=20, pady=(0, 4))
        menu = dict(width=170, height=36, corner_radius=10, fg_color=CARD, button_color=CARD, button_hover_color=LINE,
                    dropdown_fg_color=PANEL, dropdown_hover_color=LINE, text_color=TEXT, font=(FONT, 13, "bold"))
        ctk.CTkOptionMenu(row, values=[f"Sort by: {s}" for s in SORTS],
                          command=lambda v: (self.bs.update(sort=v.split(": ", 1)[1]), self.browse_go(0)),
                          **menu).pack(side="left")
        per = ctk.CTkOptionMenu(row, values=["View: 10", "View: 20", "View: 50"],
                                command=lambda v: (self.bs.update(per=int(v.split(": ")[1])), self.browse_go(0)),
                                **dict(menu, width=110))
        per.set("View: 20")
        per.pack(side="left", padx=8)
        self.pager = ctk.CTkFrame(row, fg_color="transparent")
        self.pager.pack(side="right")

    def browse_tab(self, v):
        self.bs["tab"] = v
        for n, b in self.btabs.items():
            on = n == v
            b.configure(fg_color=mix(BG, ACCENT, .22) if on else "transparent",
                        hover_color=mix(BG, ACCENT, .3) if on else LINE, text_color=ACCENT if on else TEXT)
        self.bq.configure(placeholder_text=f"Search {v.lower()}…")
        self.browse_go(0)

    def browse_go(self, page):
        self.bs["page"] = page
        self.bs["seq"] += 1
        seq, st, p, q = self.bs["seq"], dict(self.bs), self.selected, self.bq.get()
        mc = st.get("version") if st.get("discover") else p["version"]
        for w in self.results.winfo_children():
            w.destroy()
        ctk.CTkLabel(self.results, text="Loading…", text_color=MUTED).pack(pady=24)

        def work():
            try:
                hits, total = search_projects(q, mc, ALL_TABS[st["tab"]], SORTS[st["sort"]],
                                              page * st["per"], st["per"])
            except Exception as e:
                hits, total = None, str(e)
            self.after(0, lambda: seq == self.bs["seq"] and self.render_browse(hits, total))

        threading.Thread(target=work, daemon=True).start()

    def render_browse(self, hits, total):
        if not self.results.winfo_exists():
            return
        for w in self.results.winfo_children() + self.pager.winfo_children():
            w.destroy()
        if hits is None:
            ctk.CTkLabel(self.results, text=f"Search failed: {total}", text_color=MUTED).pack(pady=24)
            return
        p, cur = self.selected, self.bs["page"]
        pages = max(1, -(-total // self.bs["per"]))

        def page_btn(label, target, on=False):
            ctk.CTkButton(self.pager, text=label, width=34, height=34, corner_radius=17,
                          fg_color=mix(BG, ACCENT, .25) if on else "transparent", hover_color=LINE,
                          text_color=ACCENT if on else TEXT, font=(FONT, 13, "bold"),
                          state="normal" if target is not None else "disabled",
                          command=(lambda: self.browse_go(target)) if target is not None else None
                          ).pack(side="left", padx=1)

        shown = sorted({0, pages - 1, cur - 1, cur, cur + 1} & set(range(pages)))
        prev = None
        for n in shown:
            if prev is not None and n - prev > 1:
                page_btn("…", None)
            page_btn(f"{n + 1:,}", n, n == cur)
            prev = n
        page_btn("›", cur + 1 if cur + 1 < pages else None)
        ptype = ALL_TABS[self.bs["tab"]]
        slugs = set() if self.bs.get("discover") else {v.get("slug") for v in load_meta(self.game_dir(p)).values()}
        if self.bs.get("hide"):
            hits = [h for h in hits if h["slug"] not in slugs]
        if not hits:
            ctk.CTkLabel(self.results, text="No results for this version.", text_color=MUTED).pack(pady=24)
            return
        for h in hits:
            self.browse_card(h, ptype, h["slug"] in slugs)

