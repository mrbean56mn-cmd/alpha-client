def read_options(gdir):
    f, out = gdir / "options.txt", {}
    if f.exists():
        for line in f.read_text(encoding="utf-8", errors="ignore").splitlines():
            if ":" in line:
                k, v = line.split(":", 1)
                out[k] = v
    return out


def write_options(gdir, changes):
    """Update keys in the instance's options.txt, leaving every other setting alone."""
    f = gdir / "options.txt"
    gdir.mkdir(parents=True, exist_ok=True)
    lines = f.read_text(encoding="utf-8", errors="ignore").splitlines() if f.exists() else []
    seen, out = set(), []
    for line in lines:
        k = line.split(":", 1)[0]
        if k in changes:
            out.append(f"{k}:{changes[k]}")
            seen.add(k)
        else:
            out.append(line)
    out += [f"{k}:{v}" for k, v in changes.items() if k not in seen]
    f.write_text("\n".join(out) + "\n", encoding="utf-8")


def total_ram_gb():
    """Installed RAM in GB (Windows), or None if unknown."""
    try:
        import ctypes

        class MS(ctypes.Structure):
            _fields_ = [("len", ctypes.c_ulong), ("load", ctypes.c_ulong), ("total", ctypes.c_ulonglong),
                        ("avail", ctypes.c_ulonglong), ("tpage", ctypes.c_ulonglong), ("apage", ctypes.c_ulonglong),
                        ("tvirt", ctypes.c_ulonglong), ("avirt", ctypes.c_ulonglong), ("ext", ctypes.c_ulonglong)]

        m = MS()
        m.len = ctypes.sizeof(MS)
        if ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(m)):
            return round(m.total / 1024 ** 3)
    except Exception:
        pass
    return None


class Dialog(ctk.CTkFrame):
    """In-app modal like Modrinth's: a dimmed backdrop and a rounded card INSIDE the main window
    (below the top bar), not a separate OS window."""
    current = None
    _last = None

    @staticmethod
    def _backdrop(app, W, H, top):
        import tkinter as tk
        lbl = tk.Label(app, bg="#05070A", borderwidth=0, highlightthickness=0)
        last = Dialog._last
        if last and time.time() - last[1] < 1.5 and last[0] is not None:
            lbl.image = last[0]  # a dialog just closed: reuse its clean backdrop instead of capturing it
            lbl.configure(image=lbl.image)
            lbl.place(x=0, y=top, relwidth=1, relheight=1, height=-top)
            return lbl
        try:  # dim a snapshot of the app so the UI stays faintly visible behind the dialog
            from PIL import ImageGrab, ImageEnhance, ImageTk
            x, y = app.winfo_rootx(), app.winfo_rooty()
            shot = ImageGrab.grab(bbox=(x, y + top, x + W, y + H)).convert("RGB")
            lbl.image = ImageTk.PhotoImage(ImageEnhance.Brightness(shot).enhance(0.32))
            lbl.configure(image=lbl.image)
        except Exception:
            pass
        lbl.place(x=0, y=top, relwidth=1, relheight=1, height=-top)
        return lbl

    def __init__(self, app, width=560, height=720):
        if Dialog.current is not None:
            Dialog.current.destroy()
            app.update_idletasks()
        W, H = max(app.winfo_width(), 500), max(app.winfo_height(), 400)
        bar = getattr(app, "topbar", None)
        top = bar.winfo_height() if bar is not None and bar.winfo_exists() else 0
        back = Dialog._backdrop(app, W, H, top)
        usable = H - top
        super().__init__(app, width=min(width, W - 40), height=min(height, usable - 40), corner_radius=18,
                         fg_color=PANEL, border_width=1, border_color=LINE, bg_color="#05070A")
        self.back = back
        self.on_close = None
        self.place(relx=0.5, y=top + usable // 2, anchor="center")
        self.pack_propagate(False)
        back.bind("<Button-1>", lambda e: self.destroy())
        app.bind("<Escape>", lambda e: self.destroy() if Dialog.current is self else None)
        Dialog.current = self

    # no-op shims so dialog code written for pop-up windows keeps working
    def title(self, *a):
        pass

    def geometry(self, *a):
        pass

    def protocol(self, *a):
        pass

    def transient(self, *a):
        pass

    def grab_set(self):
        pass

    def destroy(self):
        if Dialog.current is self:
            Dialog.current = None
        cb, self.on_close = self.on_close, None
        if cb:
            cb()
        try:
            Dialog._last = (getattr(self.back, "image", None), time.time())
            self.back.destroy()
        except Exception:
            pass
        super().destroy()


