    def _iset_h(self, c, title, desc=""):
        ctk.CTkLabel(c, text=title, font=(FONT, 15, "bold")).pack(anchor="w", padx=12, pady=(16, 2))
        if desc:
            ctk.CTkLabel(c, text=desc, text_color=MUTED, wraplength=560, justify="left",
                         font=(FONT, 12)).pack(anchor="w", padx=12, pady=(0, 6))

    def _iset_entry(self, c, p, key, placeholder, width=560):
        e = ctk.CTkEntry(c, width=width, height=38, corner_radius=10, fg_color=CARD, border_color=LINE,
                         placeholder_text=placeholder)
        if p.get(key):
            e.insert(0, str(p[key]))
        e.pack(anchor="w", padx=12)

        def save(_=None):
            v = e.get().strip()
            if v:
                p[key] = v
            else:
                p.pop(key, None)
            self._save_profiles()

        e.bind("<KeyRelease>", save)
        return e

