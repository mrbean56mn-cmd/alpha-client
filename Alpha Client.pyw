        bar = ctk.CTkFrame(body, fg_color="transparent")
        bar.pack(fill="x", padx=20, pady=(10, 8))
        ctk.CTkLabel(bar, text="latest.log", font=("Consolas", 13, "bold")).pack(side="left")
        box = ctk.CTkTextbox(body, fg_color=PANEL, border_width=1, border_color=LINE, corner_radius=14,
                             font=("Consolas", 12), wrap="none")
        box.pack(fill="both", expand=True, padx=20, pady=(0, 12))

        def load():
            try:
                lines = latest.read_text(encoding="utf-8", errors="replace").splitlines()[-1500:]
                text = "\n".join(lines) or "The log is empty."
            except OSError:
                text = "No log yet. Press Play and the game's log will show up here."
            box.configure(state="normal")
            box.delete("1.0", "end")
            box.insert("1.0", text)
            box.configure(state="disabled")
            box.see("end")

        def copy():
            self.clipboard_clear()
            self.clipboard_append(box.get("1.0", "end"))
            self.say("Log copied")

        self.btn(bar, "Open logs folder", lambda: (logs.mkdir(parents=True, exist_ok=True), os.startfile(logs)),
                 flat=True, height=34, width=140).pack(side="right")
        self.btn(bar, "Copy", copy, flat=True, height=34, width=70).pack(side="right", padx=6)
        self.btn(bar, "⟳  Refresh", load, flat=True, height=34, width=100).pack(side="right")
        load()

