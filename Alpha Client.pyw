        menu = dict(height=36, corner_radius=10, fg_color=CARD, button_color=CARD, button_hover_color=LINE,
                    dropdown_fg_color=PANEL, dropdown_hover_color=LINE, text_color=TEXT, font=(FONT, 13, "bold"))
        self.ssort = ctk.CTkOptionMenu(bar, values=["Newest", "Oldest"], width=110,
                                       command=lambda v: self.render_shots(reset=True), **menu)
        self.ssort.pack(side="left", padx=(8, 0))
        names = ["All instances"] + [q["name"] for q in self.profiles]
        self.sinst = ctk.CTkOptionMenu(bar, values=names, width=160, command=lambda v: self.render_shots(reset=True),
