def _draw_cube(name):
    top, side, style = _CUBES[name]
    top, side = _rgb(top), _rgb(side)
    rnd = random.Random(name)
    faces = []
    for poly in ([(16, 4), (28, 10), (16, 16), (4, 10)], [(4, 10), (16, 16), (16, 29), (4, 23)],
                 [(16, 16), (28, 10), (28, 23), (16, 29)]):
        m = Image.new("L", (32, 32), 0)
        ImageDraw.Draw(m).polygon(poly, fill=255)
        faces.append(m.load())
    im = Image.new("RGBA", (32, 32), (0, 0, 0, 0))
    px = im.load()
    for y in range(32):
        for x in range(32):
            face = next((i for i in range(3) if faces[i][x, y]), None)
            if face is None:
                continue
            depth = 0 if face == 0 else y - (10 + (x - 4) * 0.5 if face == 1 else 16 - (x - 16) * 0.5)
            c = top if face == 0 else side
            if style == "grass" and face and depth < 3 + (rnd.random() < 0.3):
                c = top
            elif style == "planks" and face and int(depth) % 5 == 4:
                c = _shade(c, 0.7)
            elif style == "brick" and face and (int(depth) % 4 == 3 or (x + 3 * (int(depth) // 4 % 2)) % 6 == 0):
                c = (205, 196, 186)
            elif style == "lava" and rnd.random() < 0.18:
                c = (255, 214, 64)
            elif style == "shiny" and rnd.random() < 0.08:
                c = _shade(c, 1.35)
            c = _shade(c, (1.0, 0.82, 0.66)[face] * rnd.uniform(0.9, 1.07))
            px[x, y] = c + (255,)
    return im


