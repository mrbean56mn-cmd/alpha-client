                     text_color=MUTED).pack(side="left")
        body = ctk.CTkFrame(d, fg_color="transparent")
        body.pack(fill="both", expand=True)

        def img(s, size):
            im = render_icon(s, size * 2)
            return ctk.CTkImage(light_image=im, dark_image=im, size=(size, size))

        # left: preview, sizes, randomize, recents
        left = ctk.CTkFrame(body, width=250, fg_color="transparent")
