        card.pack(fill="x")
        big = ctk.CTkLabel(card, text="")
        big.pack(pady=(24, 12))
        sizes = ctk.CTkFrame(card, fg_color="transparent")
        sizes.pack(pady=(0, 20))
        small = []
        for sz in (40, 28, 18):
            lb = ctk.CTkLabel(sizes, text="", width=44, height=44)
            lb.pack(side="left", padx=3)
            small.append((lb, sz))
        self.btn(left, "⟳  Randomize", lambda: set_spec({"bg": random.randrange(len(ICON_BGS)),
                                                         "sym": random.choice(ICON_SYMBOLS)}),
                 flat=True, height=38).pack(fill="x", pady=(14, 0))
        ctk.CTkLabel(left, text="Recents", font=(FONT, 14, "bold")).pack(anchor="w", pady=(16, 6))
        rec = ctk.CTkFrame(left, fg_color="transparent")
        rec.pack(anchor="w")
        recents = [r for r in self.config_data.get("icon_recents", []) if r.get("sym") in ICON_SYMBOLS][:8]
        for i, r in enumerate(recents):
            ctk.CTkButton(rec, text="", image=img(r, 36), width=40, height=40, fg_color="transparent",
                          hover_color=LINE, corner_radius=10, command=lambda r=r: set_spec(dict(r))
                          ).grid(row=i // 4, column=i % 4, padx=2, pady=2)
        if not recents:
            ctk.CTkLabel(rec, text="Icons you save show up here.", text_color=MUTED).pack(anchor="w")

        # right: backgrounds + symbols
        right = ctk.CTkScrollableFrame(body, fg_color="transparent")
        right.pack(side="left", fill="both", expand=True, padx=(8, 12), pady=8)
        ctk.CTkLabel(right, text="Background", font=(FONT, 16, "bold")).pack(anchor="w", padx=8, pady=(6, 8))
        bgrid = ctk.CTkFrame(right, fg_color="transparent")
        bgrid.pack(anchor="w", padx=4)
        bg_btns, sym_btns = [], {}
        for i in range(len(ICON_BGS)):
            b = ctk.CTkButton(bgrid, text="", image=img({"bg": i}, 64), width=72, height=72, corner_radius=16,
                              fg_color="transparent", hover_color=LINE, border_width=2, border_color=BG,
                              command=lambda i=i: set_spec(dict(spec, bg=i)))
            b.grid(row=i // 6, column=i % 6, padx=3, pady=3)
            bg_btns.append(b)
        ctk.CTkFrame(right, height=1, fg_color=LINE).pack(fill="x", padx=8, pady=16)
        ctk.CTkLabel(right, text="Symbol", font=(FONT, 16, "bold")).pack(anchor="w", padx=8, pady=(0, 8))
        sgrid = ctk.CTkFrame(right, fg_color="transparent")
        sgrid.pack(anchor="w", padx=4)
        for i, name in enumerate(ICON_SYMBOLS):
            sim = symbol_image(name).resize((112, 112), Image.NEAREST)
            b = ctk.CTkButton(sgrid, text="", image=ctk.CTkImage(light_image=sim, dark_image=sim, size=(56, 56)),
                              width=84, height=84, corner_radius=16, fg_color=BG, hover_color=LINE,
                              border_width=1, border_color=LINE, command=lambda n=name: set_spec(dict(spec, sym=n)))
            b.grid(row=i // 7, column=i % 7, padx=4, pady=4)
            sym_btns[name] = b

        def set_spec(s):
            spec.clear()
            spec.update(s)
            big.configure(image=img(spec, 128))
            for lb, sz in small:
                lb.configure(image=img(spec, sz))
            for i, b in enumerate(bg_btns):
                b.configure(border_color=ACCENT if i == spec["bg"] else BG)
            for n, b in sym_btns.items():
                on = n == spec["sym"]
                b.configure(border_color=ACCENT if on else LINE, border_width=2 if on else 1)

        def save():
            old = p.get("icon") or {}
            if old.get("file"):
                (self.game_dir(p) / old["file"]).unlink(missing_ok=True)
            p["icon"] = dict(spec)
            rs = [dict(spec)] + [r for r in self.config_data.get("icon_recents", []) if r != spec]
            self.config_data["icon_recents"] = rs[:8]
            self.save_cfg()
            d.destroy()
            self._icon_changed(p)

        self.btn(foot, "Save icon", save, width=120, height=38).pack(side="right")
        self.btn(foot, "Cancel", d.destroy, flat=True, width=100, height=38).pack(side="right", padx=8)
        set_spec(dict(spec))

    def refresh_content(self):
        p = self.selected
        gdir = self.game_dir(p)
        meta = load_meta(gdir)
        want = {"All": None, "Mods": "mod", "Resource Packs": "resourcepack", "Shaders": "shader"}[self.cfilter_val]
        text = self.cq.get().lower()
        for w in self.content_list.winfo_children():
            w.destroy()
        items, totals = [], {"mod": 0, "resourcepack": 0, "shader": 0}
        for ptype, folder in FOLDERS.items():
            d = gdir / folder
            if not d.exists():
                continue
            for f in sorted(d.iterdir(), key=lambda x: x.name.lower()):
                if not f.is_file() or not f.name.endswith((".jar", ".zip", ".jar.disabled", ".zip.disabled")):
                    continue
                totals[ptype] += 1
                enabled = not f.name.endswith(".disabled")
                base = f.name if enabled else f.name[:-9]
                m = meta.get(base, {})
                title = m.get("title") or base
                if (want and ptype != want) or (text and text not in title.lower() and text not in base.lower()):
                    continue
                items.append((title.lower(), f, base, title, m, enabled))
        for name, key in (("All", None), ("Mods", "mod"), ("Resource Packs", "resourcepack"), ("Shaders", "shader")):
            n = sum(totals.values()) if key is None else totals[key]
            self.cfilter_btns[name].configure(text=f"{name}  {n}" if n else name)
        total = sum(totals.values())
        self.cq.configure(placeholder_text=f"Search {total} project{'s' if total != 1 else ''}…")
        on = sum(1 for it in items if it[5])
        self.content_summary.configure(text=f"Project   ·   {len(items)} shown, {on} enabled" if items else "Project")
        order = getattr(self, "csort", None)
        order = order.get() if order is not None else "Name (A-Z)"
        if order == "Name (Z-A)":
            items.sort(key=lambda it: it[0], reverse=True)
        elif order == "Enabled first":
            items.sort(key=lambda it: (not it[5], it[0]))
        elif order == "Recently added":
            items.sort(key=lambda it: -it[1].stat().st_mtime)
        else:
            items.sort(key=lambda it: it[0])
        for i, (_, f, base, title, m, enabled) in enumerate(items):
            if i:
                ctk.CTkFrame(self.content_list, height=1, fg_color=LINE).pack(fill="x", padx=10)
            self.content_row(f, base, title, m, enabled)
        if not items:
            msg = ("No matches. Try a different search." if text else
                   "Nothing here yet. Click Browse content to add mods, resource packs and shaders.")
            ctk.CTkLabel(self.content_list, text=msg, text_color=MUTED).pack(pady=32)

    def content_row(self, f, base, title, m, enabled):
        row = ctk.CTkFrame(self.content_list, fg_color="transparent", corner_radius=10)
        row.pack(fill="x", pady=1, padx=(0, 6))
        ic = ctk.CTkLabel(row, text=title[:1].upper(), width=42, height=42, corner_radius=10, fg_color=LINE,
                          text_color=MUTED, font=(FONT, 17, "bold"))
        ic.pack(side="left", padx=(12, 12), pady=9)
        self.set_remote_icon(ic, m.get("icon"), 42)
        info = ctk.CTkFrame(row, fg_color="transparent")
        info.pack(side="left", fill="x", expand=True)
        name_lbl = ctk.CTkLabel(info, text=short(title, 40), font=(FONT, 14, "bold"), anchor="w",
                                text_color=TEXT if enabled else MUTED)
        name_lbl.pack(anchor="w")
        ctk.CTkLabel(info, text=short(base, 56), text_color=MUTED, anchor="w", font=(FONT, 12)).pack(anchor="w")
        kind = {"mod": "Mod", "resourcepack": "Resource pack", "shader": "Shader"}.get(m.get("type"), "")
        right = ctk.CTkFrame(row, fg_color="transparent")

        def delete():
            f.unlink(missing_ok=True)
            with META_LOCK:
                meta = load_meta(self.game_dir(self.selected))
                if meta.pop(base, None) is not None:
                    save_json(self.game_dir(self.selected) / "alpha_content.json", meta)
            self.refresh_content()

        state = {"f": f}

        def toggle():
            cur = state["f"]
            new = cur.with_name(base if cur.name.endswith(".disabled") else base + ".disabled")
            cur.rename(new)
            state["f"] = new
            name_lbl.configure(text_color=TEXT if not new.name.endswith(".disabled") else MUTED)

        right.pack(side="right", padx=(8, 10))
        ver = m.get("version")
        if ver or kind:
            col = ctk.CTkFrame(right, fg_color="transparent", width=150)
            col.pack(side="left", padx=(0, 14))
            if ver:
                ctk.CTkLabel(col, text=short(ver, 22), font=("Consolas", 12), text_color=TEXT, anchor="e").pack(anchor="e")
            if kind:
                ctk.CTkLabel(col, text=kind, font=(FONT, 11), text_color=MUTED, anchor="e").pack(anchor="e")
        sw = ctk.CTkSwitch(right, text="", width=46, progress_color=ACCENT, command=toggle)
        if enabled:
            sw.select()
        sw.pack(side="left")
        ctk.CTkButton(right, text="", image=make_icon("trash", MUTED, 16), width=34, height=34, corner_radius=8,
                      fg_color="transparent", hover_color=mix(CARD, "#FF6B6B", .2),
                      command=delete).pack(side="left", padx=(6, 0))
        menu_items = []
        if m.get("slug"):
            ptype = m.get("type", "mod")
            menu_items.append(("compass", "Open on Modrinth",
                               lambda: webbrowser.open(f"https://modrinth.com/{ptype}/{m['slug']}")))
        menu_items.append(("download", "Show in folder",
                           lambda: subprocess.Popen(["explorer", "/select,", str(state["f"])])
                           if sys.platform == "win32" else self.open_folder(self.selected)))
        dots = ctk.CTkButton(right, text="⋮", width=30, height=34, corner_radius=8, fg_color="transparent",
                             hover_color=LINE, text_color=MUTED, font=(FONT, 18, "bold"))
        dots.configure(command=lambda: self.after(10, lambda: self.popup_menu(dots, menu_items)))
        dots.pack(side="left")
        self.hover_row(row, "transparent")

    def open_folder(self, p):
        d = self.game_dir(p)
        d.mkdir(parents=True, exist_ok=True)
        os.startfile(d) if sys.platform == "win32" else webbrowser.open(d.as_uri())

    def delete(self, p):
        self.profiles = [x for x in self.profiles if x["id"] != p["id"]]
        save_json(PROFILES_FILE, self.profiles)
        self.build_rail()
        self.show_home()

    # ---------- modules (performance / visual / utility) ----------
    def module_files(self, p, slug):
        gdir = self.game_dir(p)
        out = []
        for fn, m in load_meta(gdir).items():
            if m.get("slug") == slug and m.get("type") == "mod":
                for cand in (gdir / "mods" / fn, gdir / "mods" / (fn + ".disabled")):
                    if cand.exists():
                        out.append(cand)
        return out

    def module_on(self, p, m, opts):
        if m["kind"] == "mod":
            return any(not f.name.endswith(".disabled") for f in self.module_files(p, m["data"][0]))
        key, on, off, default = m["data"]
        return (opts.get(key) == on) if key in opts else default

    @navigable
    def show_modules(self, p):
        self.selected = p
        pg = self.new_page(scroll=True)
        head = ctk.CTkFrame(pg, fg_color="transparent")
