        for q in self.profiles:
            d = self.game_dir(q) / "screenshots"
            if d.exists():
                for f in d.iterdir():
                    if f.suffix.lower() in (".png", ".jpg", ".jpeg"):
                        try:
                            self._shots.append((f.stat().st_mtime, f, q))
                        except OSError:
                            pass
        self._thumbs = getattr(self, "_thumbs", {})
        self.render_shots(reset=True)

    def render_shots(self, reset=False):
        from datetime import datetime
        if reset:
            self._shot_limit = 24
        for w in self.shot_list.winfo_children():
            w.destroy()
        text, inst = self.sq.get().lower(), self.sinst.get()
        items = [s for s in self._shots if (not text or text in s[1].name.lower() or text in s[2]["name"].lower())
                 and (inst == "All instances" or s[2]["name"] == inst)]
        items.sort(key=lambda s: s[0], reverse=self.ssort.get() == "Newest")
        if not items:
            ctk.CTkLabel(self.shot_list, text="No screenshots yet. Press F2 in game to take one." if not self._shots
                         else "No screenshots match.", text_color=MUTED).pack(pady=40)
            return
        now = datetime.now()
        groups = []
        for s in items[:self._shot_limit]:
            dt = datetime.fromtimestamp(s[0])
            label = "This month" if (dt.year, dt.month) == (now.year, now.month) else dt.strftime("%B %Y")
            if not groups or groups[-1][0] != label:
                groups.append((label, []))
            groups[-1][1].append(s)
        counts = {}
        for s in items:
            dt = datetime.fromtimestamp(s[0])
            lb = "This month" if (dt.year, dt.month) == (now.year, now.month) else dt.strftime("%B %Y")
            counts[lb] = counts.get(lb, 0) + 1
        for label, shots in groups:
            h = ctk.CTkFrame(self.shot_list, fg_color="transparent")
            h.pack(fill="x", padx=6, pady=(12, 6))
            ctk.CTkLabel(h, text=label, font=(FONT, 15, "bold")).pack(side="left")
            ctk.CTkLabel(h, text=f"  {counts[label]}", text_color=MUTED).pack(side="left")
            grid = ctk.CTkFrame(self.shot_list, fg_color="transparent")
            grid.pack(fill="x")
            for i, s in enumerate(shots):
                self.shot_tile(grid, s).grid(row=i // 3, column=i % 3, padx=5, pady=5, sticky="n")
        if len(items) > self._shot_limit:
            self.btn(self.shot_list, f"Show more ({len(items) - self._shot_limit} left)",
                     lambda: (setattr(self, "_shot_limit", self._shot_limit + 24), self.render_shots()),
                     flat=True, height=36, width=180).pack(pady=14)

    def shot_tile(self, parent, s):
        _, f, q = s
        tile = ctk.CTkFrame(parent, fg_color=CARD, corner_radius=12, width=232)
        img = ctk.CTkLabel(tile, text="Loading…", width=220, height=124, corner_radius=8, fg_color=LINE,
                           text_color=MUTED, cursor="hand2")
        img.pack(padx=6, pady=(6, 4))
        img.bind("<Button-1>", lambda e: os.startfile(f) if sys.platform == "win32" else None)
        cap = ctk.CTkFrame(tile, fg_color="transparent")
        cap.pack(fill="x", padx=8, pady=(0, 6))
        txt = ctk.CTkFrame(cap, fg_color="transparent")
        txt.pack(side="left", fill="x", expand=True)
        ctk.CTkLabel(txt, text=short(f.stem, 22), font=(FONT, 12, "bold"), anchor="w").pack(anchor="w")
        ctk.CTkLabel(txt, text=short(q["name"], 24), font=(FONT, 11), text_color=MUTED, anchor="w").pack(anchor="w")
        dots = ctk.CTkButton(cap, text="⋮", width=26, height=28, corner_radius=8, fg_color="transparent",
                             hover_color=LINE, text_color=MUTED, font=(FONT, 16, "bold"))
        dots.configure(command=lambda: self.after(10, lambda: self.popup_menu(dots, [
            ("upload", "Open", lambda: os.startfile(f)),
            ("import", "Copy image", lambda: self.copy_image(f)),
            ("download", "Show in folder", lambda: subprocess.Popen(["explorer", "/select,", str(f)])),
            ("trash", "Delete", lambda: self.delete_shot(f))])))
        dots.pack(side="right")

        def work():
            try:
                if f not in self._thumbs:
                    im = Image.open(f).convert("RGB")
                    im.thumbnail((440, 248))
                    self._thumbs[f] = im
                im = self._thumbs[f]
                ci = ctk.CTkImage(light_image=im, dark_image=im, size=(220, int(220 * im.height / im.width)))
                self.after(0, lambda: img.winfo_exists() and img.configure(image=ci, text="", fg_color="transparent"))
            except Exception:
                self.after(0, lambda: img.winfo_exists() and img.configure(text="Can't preview"))

        self.pool.submit(work)
        return tile

    def copy_image(self, f):
        """Put the screenshot itself on the clipboard so it can be pasted into Discord etc."""
        ps = ("Add-Type -AssemblyName System.Windows.Forms,System.Drawing;"
              "[System.Windows.Forms.Clipboard]::SetImage([System.Drawing.Image]::FromFile($args[0]))")
        subprocess.Popen(["powershell", "-NoProfile", "-STA", "-Command", ps, str(f)],
                         creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
        self.say("Screenshot copied")

    def delete_shot(self, f):
        def go():
            ps = ("Add-Type -AssemblyName Microsoft.VisualBasic;"
                  "[Microsoft.VisualBasic.FileIO.FileSystem]::DeleteFile($args[0],'OnlyErrorDialogs','SendToRecycleBin')")
            subprocess.run(["powershell", "-NoProfile", "-Command", ps, str(f)],
                           creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
            self._shots = [s for s in self._shots if s[1] != f]
            self.render_shots()
            self.say("Screenshot moved to the Recycle Bin")

        self.notice("Delete screenshot?", f"{f.name} will be moved to the Recycle Bin.",
                    [("Delete", go, False)], close="Cancel")

    # ---------- skins ----------
    @navigable
    def show_skins(self):
        pg = self.new_page()
        self._skin_sel = getattr(self, "_skin_sel", None)
        left = ctk.CTkFrame(pg, width=250, fg_color="transparent")
        left.pack(side="left", fill="y", padx=(20, 10), pady=18)
        left.pack_propagate(False)
        ctk.CTkLabel(left, text="Skin selector", font=(FONT, 24, "bold")).pack(anchor="w")
        self.skin_name = ctk.CTkLabel(left, text="", text_color=MUTED, font=("Consolas", 13))
        self.skin_name.pack(pady=(26, 6))
        self.skin_big = ctk.CTkLabel(left, text="", width=150, height=300)
        self.skin_big.pack()
        self.skin_actions = ctk.CTkFrame(left, fg_color="transparent")
        self.skin_actions.pack(fill="x", pady=(14, 0))
        right = ctk.CTkScrollableFrame(pg, fg_color="transparent")
        right.pack(side="left", fill="both", expand=True, padx=(0, 12), pady=10)
