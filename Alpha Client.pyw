    def upload_files(self, p):
        from tkinter import filedialog
        paths = filedialog.askopenfilenames(title="Add mods, resource packs or shaders",
                                            filetypes=[("Minecraft content", "*.jar *.zip"), ("All files", "*.*")])
        if not paths:
            return
        g = self.game_dir(p)
        n = 0
        for src in paths:
            src = Path(src)
            if src.suffix.lower() == ".jar":
                folder = "mods"
            elif src.suffix.lower() == ".zip":
                folder = "shaderpacks" if self.cfilter_val == "Shaders" else "resourcepacks"
            else:
                continue
            (g / folder).mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, g / folder / src.name)
            n += 1
        self.say(f"Added {n} file{'s' if n != 1 else ''}" + (" (zips go to Shaders while that tab is selected)"
                                                            if n and self.cfilter_val != "Shaders" else ""))
        self.refresh_content()

