            ctk.CTkLabel(chips, text=t, height=24, corner_radius=12, fg_color=CARD, text_color=MUTED,
                         font=(FONT, 11)).pack(side="left", padx=(0, 5), ipadx=6)
        for w in (card, ic, mid, title, *title.winfo_children()):
            w.bind("<Double-Button-1>", lambda e: webbrowser.open(f"https://modrinth.com/{h.get('project_type', ptype)}/{h['slug']}"))

    def install_click(self, b, h, ptype):
        p = self.selected
        b.configure(text="Installing…", state="disabled")

        def work():
            retry = False
            try:
                f = install_project(h["slug"], ptype, p["version"], self.game_dir(p))
                txt = "✓  Installed" if f else "No version"
                self.say(f"Installed {h['title']}" if f else f"{h['title']} has no build for {p['version']}")
            except Exception as e:
                txt, retry = "Retry", True
                self.say(f"Error: {e}")
            self.after(0, lambda: b.winfo_exists() and b.configure(text=txt, state="normal" if retry else "disabled"))

        threading.Thread(target=work, daemon=True).start()

    # ---------- screenshots (all instances) ----------
    @navigable
    def show_screenshots(self):
