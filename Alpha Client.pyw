    def load_avatar(self, name):
        try:
            if name not in self.avatar_cache:
                data = requests.get(f"https://mc-heads.net/avatar/{name}/64", headers=HEADERS, timeout=8).content
                self.avatar_cache[name] = Image.open(io.BytesIO(data)).convert("RGBA")
            img = ctk.CTkImage(self.avatar_cache[name], size=(36, 36))
            self.after(0, lambda: self.avatar.configure(image=img, text="", fg_color=CARD))
        except Exception:
            pass

    NEWS_HOST = "https://launchercontent.mojang.com"

    def load_news(self):
        """Mojang's Java patch notes feed (the same one the official launcher uses)."""
        entries, img = None, None
        try:
            r = requests.get(self.NEWS_HOST + "/v2/javaPatchNotes.json", headers=HEADERS, timeout=8)
            entries = r.json()["entries"][:3]
            url = (entries[0].get("image") or {}).get("url")
            if url:
                img = Image.open(io.BytesIO(requests.get(self.NEWS_HOST + url, headers=HEADERS, timeout=8).content))
                img = img.convert("RGB")
        except Exception:
            entries = None
        self._news = (entries, img)
        self.after(0, lambda: self.render_news(entries, img))

    def render_news(self, entries, img):
        if not self.news.winfo_exists():
            return
        for w in self.news.winfo_children():
            w.destroy()
        if not entries:
            ctk.CTkLabel(self.news, text="Couldn't load news. Check your internet connection.", text_color=MUTED,
                         wraplength=240, justify="left").pack(anchor="w", padx=4)
            ctk.CTkButton(self.news, text="Try again", height=30, width=90, corner_radius=8, fg_color=CARD,
                          hover_color=LINE, text_color=TEXT,
                          command=lambda: threading.Thread(target=self.load_news, daemon=True).start()
                          ).pack(anchor="w", padx=4, pady=8)
            return
        from datetime import datetime

        def when(e):
            try:
                return ago(datetime.fromisoformat(e["date"].replace("Z", "+00:00")).timestamp())
            except Exception:
                return ""

        e = entries[0]
        card = ctk.CTkFrame(self.news, fg_color=CARD, corner_radius=14, cursor="hand2")
        card.pack(fill="x")
        parts = [card]
        if img is not None:
            w, h = 516, 260  # 2x for a crisp 258x130 banner
            src = img.copy()
            scale = max(w / src.width, h / src.height)
            src = src.resize((int(src.width * scale) + 1, int(src.height * scale) + 1), Image.LANCZOS)
            left, top = (src.width - w) // 2, (src.height - h) // 3
            ban = src.crop((left, top, left + w, top + h)).convert("RGBA")
            mask = Image.new("L", (w, h), 0)
            ImageDraw.Draw(mask).rounded_rectangle([0, 0, w - 1, h + 40], radius=26, fill=255)
            out = Image.new("RGBA", (w, h), (0, 0, 0, 0))
            out.paste(ban, (0, 0), mask)
            pic = ctk.CTkLabel(card, text="", image=ctk.CTkImage(out, size=(w // 2, h // 2)))
            pic.pack()
            parts.append(pic)
        meta = ctk.CTkFrame(card, fg_color="transparent")
        meta.pack(fill="x", padx=12, pady=(10, 0))
        kind = "Release" if e.get("type") == "release" else "Snapshot"
        chip = ctk.CTkLabel(meta, text=kind, height=20, corner_radius=10, font=(FONT, 10, "bold"),
                            fg_color=mix(CARD, "#1BD96A" if kind == "Release" else ACCENT, .25),
                            text_color="#1BD96A" if kind == "Release" else ACCENT)
        chip.pack(side="left", ipadx=6)
        dl = ctk.CTkLabel(meta, text=when(e), text_color=MUTED, font=(FONT, 11))
        dl.pack(side="right")
        t1 = ctk.CTkLabel(card, text=e["title"], font=(FONT, 14, "bold"), wraplength=234, justify="left", anchor="w")
        t1.pack(anchor="w", padx=12, pady=(6, 2))
        t2 = ctk.CTkLabel(card, text=short(e.get("shortText", ""), 120), text_color=MUTED, font=(FONT, 12),
                          wraplength=234, justify="left", anchor="w")
        t2.pack(anchor="w", padx=12)
        rm = ctk.CTkLabel(card, text="Read more  →", text_color=ACCENT, font=(FONT, 12, "bold"), cursor="hand2")
        rm.pack(anchor="w", padx=12, pady=(6, 12))
        parts += [meta, chip, dl, t1, t2, rm]
        for p in parts:
            p.bind("<Button-1>", lambda ev, e=e: self.news_article(e))
        for e2 in entries[1:]:
            r = ctk.CTkFrame(self.news, fg_color="transparent", corner_radius=10, cursor="hand2")
            r.pack(fill="x", pady=(6, 0))
            a = ctk.CTkLabel(r, text=short(e2["title"], 30), font=(FONT, 12, "bold"), anchor="w")
            a.pack(anchor="w", padx=8, pady=(6, 0))
            b = ctk.CTkLabel(r, text=when(e2), text_color=MUTED, font=(FONT, 11), anchor="w")
            b.pack(anchor="w", padx=8, pady=(0, 6))
            for p in (r, a, b):
                p.bind("<Button-1>", lambda ev, e2=e2: self.news_article(e2))
            self.hover_row(r, "transparent")

    def news_article(self, e):
        """Full patch notes, shown inside Alpha."""
        d = Dialog(self, 640, 640)
        self.dialog_header(d, short(e["title"], 40))
        box = ctk.CTkTextbox(d, fg_color="transparent", wrap="word", font=(FONT, 13), border_width=0)
        box.pack(fill="both", expand=True, padx=20, pady=(10, 16))
        box.insert("1.0", "Loading patch notes…")
        box.configure(state="disabled")

        def work():
            try:
                j = requests.get(self.NEWS_HOST + "/v2/" + e["contentPath"].lstrip("/"), headers=HEADERS, timeout=10).json()
                html = j.get("body", "")
                html = re.sub(r"(?i)<h[1-3][^>]*>(.*?)</h[1-3]>", lambda m: "\n\n" + m.group(1).upper() + "\n", html)
                html = re.sub(r"(?i)<li[^>]*>", "\n  •  ", html)
                html = re.sub(r"(?i)<br\s*/?>|</p>", "\n", html)
                text = re.sub(r"<[^>]+>", "", html)
                import html as h
                text = re.sub(r"\n{3,}", "\n\n", h.unescape(text)).strip()
            except Exception as ex:
                text = f"Couldn't load the patch notes ({ex})."

            def show():
                if box.winfo_exists():
                    box.configure(state="normal")
                    box.delete("1.0", "end")
                    box.insert("1.0", text)
                    box.configure(state="disabled")
            self.after(0, show)

        threading.Thread(target=work, daemon=True).start()

