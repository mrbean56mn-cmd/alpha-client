                      text_color=TEXT, command=lambda: self.show_instance(p)).pack(side="left")
        info = ctk.CTkFrame(head, fg_color="transparent")
        info.pack(side="left", padx=12)
        ctk.CTkLabel(info, text="Modules", font=(FONT, 22, "bold")).pack(anchor="w")
        ctk.CTkLabel(info, text=f"{p['name']}  ·  {p['loader'].title()} {p['version']}", text_color=MUTED).pack(anchor="w")
        ctk.CTkLabel(pg, text="Performance, visual and quality-of-life modules only. No hacks, no unfair advantages.",
                     text_color=MUTED).pack(anchor="w", padx=20, pady=(6, 0))
