    def render_grid(self, filt):
        for w in self.grid.winfo_children():
            w.destroy()
        items = [p for p in self.profiles if filt.lower() in p["name"].lower()]
        for i, p in enumerate(items):
            card = ctk.CTkFrame(self.grid, fg_color=CARD, corner_radius=14, width=160, height=190)
            card.grid(row=i // 4, column=i % 4, padx=6, pady=6)
            card.pack_propagate(False)
            self.icon(card, p, 90).pack(pady=(16, 8))
            ctk.CTkLabel(card, text=short(p["name"], 16), font=(FONT, 14, "bold")).pack()
            ctk.CTkLabel(card, text=f"{p['loader'].title()} {p['version']}", text_color=MUTED).pack()
            for w in [card, *card.winfo_children()]:
                w.bind("<Button-1>", lambda e, p=p: self.show_instance(p))
        if not items:
            ctk.CTkLabel(self.grid, text="No instances yet.", text_color=MUTED).grid(padx=10, pady=10)

    # ---------- instance ----------
    # ---------- create instance ----------
    def add_instance(self, name, version, loader, ram=4, pack=False):
        p = {"id": uuid.uuid4().hex[:8], "name": (name or "New instance")[:40], "version": version,
             "loader": loader, "ram": ram, "installed": False, "pack": pack}
        self.profiles.append(p)
        save_json(PROFILES_FILE, self.profiles)
        self.after(0, self.build_rail)
        return p

    def run_task(self, fn):
        def work():
            try:
                fn()
            except Exception as e:
                msg = str(e)
                self.say(f"Error: {msg}")
                self.after(0, lambda: self.notice("Something went wrong", msg))

        threading.Thread(target=work, daemon=True).start()

    def import_mrpack(self, path, name=None):
        idx = mrpack_info(path)
        deps = idx.get("dependencies", {})
        if any(k in deps for k in ("forge", "neoforge", "quilt-loader")):
            raise RuntimeError("Only Fabric and vanilla modpacks are supported right now.")
        p = self.add_instance(name or idx.get("name"), deps.get("minecraft"),
                              "fabric" if "fabric-loader" in deps else "vanilla", ram=6)
        install_mrpack(path, self.game_dir(p), self.say)
        self.say(f"{p['name']} is ready")
        self.after(0, lambda: self.show_instance(p))

    def start_from_project(self, h):
        def job():
            self.say(f"Setting up {h['title']}…")
            r = requests.get(f"{MODRINTH}/project/{h['slug']}/version", headers=HEADERS, timeout=15,
                             params={"loaders": json.dumps(["fabric"])})
            r.raise_for_status()
            if not r.json():
                raise RuntimeError(f"{h['title']} has no Fabric version available.")
            v = r.json()[0]
            if h["project_type"] == "modpack":
                f = next((x for x in v["files"] if x.get("primary")), v["files"][0])
                tmp = ROOT / "tmp"
                tmp.mkdir(exist_ok=True)
                path = tmp / f["filename"]
                path.write_bytes(requests.get(f["url"], headers=HEADERS, timeout=300).content)
                self.import_mrpack(path, h["title"])
            else:
                mc = newest_mc(v["game_versions"])
                p = self.add_instance(h["title"], mc, "fabric")
                install_project(h["slug"], "mod", mc, self.game_dir(p))
                self.say(f"{p['name']} is ready")
                self.after(0, lambda: self.show_instance(p))

        self.run_task(job)

    def upload_modpack(self):
        from tkinter import filedialog
        path = filedialog.askopenfilename(title="Choose a modpack", filetypes=[("Modrinth modpack", "*.mrpack")])
        if path:
            self.run_task(lambda: self.import_mrpack(Path(path)))

    def import_instance(self):
        from tkinter import filedialog
        folder = filedialog.askdirectory(title="Choose a Prism / MultiMC / CurseForge instance folder")
        if folder:
            self.run_task(lambda: self.import_folder(folder))

    def import_folder(self, folder):
        info = read_import(folder)
        if not info:
            raise RuntimeError("That folder doesn't look like a Prism/MultiMC or CurseForge instance.")
        name, mc, loader, src = info
        if loader == "unsupported" or not mc:
            raise RuntimeError("Only Fabric and vanilla instances can be imported right now.")
        p = self.add_instance(name, mc, loader)
        g = self.game_dir(p)
        g.mkdir(parents=True, exist_ok=True)
        for sub in ("mods", "resourcepacks", "shaderpacks", "config", "saves"):
            if (src / sub).exists():
                self.say(f"Copying {sub}…")
                shutil.copytree(src / sub, g / sub, dirs_exist_ok=True)
        if (src / "options.txt").exists():
            shutil.copy2(src / "options.txt", g / "options.txt")
        self.say(f"Imported {name}")
        self.after(0, lambda: self.show_instance(p))

