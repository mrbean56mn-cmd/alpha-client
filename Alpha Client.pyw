        self.sh(c, "Troubleshooting")
        items = [("Check for updates", f"You're on Alpha Client {VERSION}.",
                  lambda: (self.sdlg.destroy(), self.check_update(manual=True))),
                 ("Create desktop shortcut", "Adds an Alpha shortcut with the Alpha icon to your desktop.",
                  lambda: (make_shortcut(force=True), self.say("Desktop shortcut created"))),
                 ("Re-verify game files", "Re-downloads missing Minecraft files the next time you press Play.", self.reverify),
                 ("Reset settings", "Restores theme and defaults. Your instances and account are kept.", self.reset_settings)]
        for title, desc, cmd in items:
            row = ctk.CTkFrame(c, fg_color="transparent")
            row.pack(fill="x", padx=24, pady=10)
            tx = ctk.CTkFrame(row, fg_color="transparent")
            tx.pack(side="left", fill="x", expand=True)
            ctk.CTkLabel(tx, text=title, font=(FONT, 15, "bold")).pack(anchor="w")
            ctk.CTkLabel(tx, text=desc, text_color=MUTED, justify="left", wraplength=400).pack(anchor="w")
            self.btn(row, "Run", cmd, flat=True, width=80, height=34).pack(side="right")

    def reverify(self):
        for p in self.profiles:
            p["installed"] = False
        save_json(PROFILES_FILE, self.profiles)
        self.say("Game files will be re-checked on next launch")

    def reset_settings(self):
        keep = {k: v for k, v in self.config_data.items() if k in ("ms_client_id", "ms_working")}
        self.config_data = keep
        self.set_theme("Dark", "Blue")


if __name__ == "__main__":
    if startup_update():  # a newer Alpha was waiting: it's installed and starting now
        sys.exit(0)
    ensure_assets()
    threading.Thread(target=make_shortcut, daemon=True).start()
    Alpha().mainloop()
