_LOGO_CACHE = {}


def logo_image(color="#FFFFFF"):
    """The Alpha logo in any colour (white on dark themes, dark on the light theme), transparent background."""
    if color not in _LOGO_CACHE:
        base = Image.open(io.BytesIO(base64.b64decode(_LOGO_B64))).convert("RGBA")
        tinted = Image.new("RGBA", base.size, _rgb(color) + (0,))
        tinted.putalpha(base.getchannel("A"))
        _LOGO_CACHE[color] = tinted
    return _LOGO_CACHE[color]


def star_banner(w, h, name, sub, accent="#3BA7FF", seed=7):
    """Home banner in the logo's style: deep space, a few stars, an orbit ring and the logo on the right."""
    from PIL import ImageFont
    S = 2  # draw at 2x for smooth edges
    W, H = w * S, h * S
    im = Image.new("RGBA", (W, H))
    d = ImageDraw.Draw(im)
    a, b = (14, 18, 30), (5, 6, 10)
    for x in range(W):
        t = x / (W - 1)
        d.line([(x, 0), (x, H)], fill=tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3)) + (255,))
    glow = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    gd = ImageDraw.Draw(glow)
    ac = _rgb(accent)
    gd.ellipse([W - H * 1.6, -H * 0.4, W + H * 0.2, H * 1.4], fill=ac + (70,))
    im.alpha_composite(glow.filter(ImageFilter.GaussianBlur(H // 3)))
    rnd = random.Random(seed)
    for _ in range(70):
        x, y, r = rnd.randrange(W), rnd.randrange(H), rnd.choice((1, 1, 1, 2, 2, 3))
        v = rnd.randrange(90, 230)
        d.ellipse([x - r, y - r, x + r, y + r], fill=(v, v, min(255, v + 20), 255))
    for cx, cy, r in ((W * 0.58, H * 0.22, 9 * S), (W * 0.42, H * 0.78, 6 * S)):  # four-point sparkles
        d.polygon([(cx, cy - r), (cx + r * .22, cy - r * .22), (cx + r, cy), (cx + r * .22, cy + r * .22),
                   (cx, cy + r), (cx - r * .22, cy + r * .22), (cx - r, cy), (cx - r * .22, cy - r * .22)],
                  fill=(235, 242, 255, 255))
    ring = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    ImageDraw.Draw(ring).ellipse([W * 0.55, H * 0.18, W * 1.08, H * 0.92], outline=(255, 255, 255, 40), width=2 * S)
    im.alpha_composite(ring.rotate(-12, center=(W * 0.8, H * 0.55)))
    n = int(H * 0.86)
    im.alpha_composite(logo_image().resize((n, n), Image.LANCZOS), (W - n - 34 * S, (H - n) // 2))

    def font(size, bold):
        for f in (("segoeuib.ttf" if bold else "segoeui.ttf"), "arialbd.ttf" if bold else "arial.ttf"):
            try:
                return ImageFont.truetype(f, size * S)
            except Exception:
                pass
        return ImageFont.load_default()

    d.text((28 * S, h * S // 2 - 30 * S), name, font=font(26, True), fill=(240, 244, 250, 255))
    d.text((29 * S, h * S // 2 + 8 * S), sub, font=font(14, False), fill=(150, 160, 176, 255))
    mask = Image.new("L", (W, H), 0)
    ImageDraw.Draw(mask).rounded_rectangle([0, 0, W - 1, H - 1], radius=16 * S, fill=255)
    out = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    out.paste(im, (0, 0), mask)
    return out


# ---------- self-update (from the master copy) ----------
def _file_version(text):
    m = re.search(r'^VERSION = "([^"]+)"', text, re.M)
    return m.group(1) if m else "?"


def _vtuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v or "")) or (0,)


def find_update(timeout=8):
    """Ask GitHub for the latest Alpha. Returns (new_version, new_bytes) when it's newer than this copy, else None.
    Offline, GitHub down, or a broken download all count as "no update", so Alpha always still starts."""
    try:
        me = Path(__file__).resolve()
        if MASTER_COPY.exists() and me == MASTER_COPY.resolve():
            return None  # the developer's master copy never replaces itself
        import requests
        r = requests.get(UPDATE_URL, params={"t": int(time.time() // 60)}, timeout=timeout,
                         headers={"User-Agent": "alpha-client-updater", "Cache-Control": "no-cache"})
        if r.status_code != 200:
            return None
        new = r.content
        text = new.decode("utf-8", "replace")
        ver = _file_version(text)
        if _vtuple(ver) <= _vtuple(VERSION):
            return None
        compile(text, "Alpha Client.pyw", "exec")  # never install a half-downloaded or broken file
        if "class Alpha(" not in text:
            return None
        return ver, new
    except Exception:
        return None


def install_update(new_bytes, relaunch=True):
    """Replace this file with the new version (and start it again unless relaunch=False)."""
    me = Path(__file__).resolve()
    tmp = me.with_name(me.name + ".new")
    tmp.write_bytes(new_bytes)
    os.replace(tmp, me)
    if not relaunch:
        return
    exe = Path(sys.executable)
    if exe.with_name("pythonw.exe").exists():
        exe = exe.with_name("pythonw.exe")
    subprocess.Popen([str(exe), str(me)], cwd=str(me.parent),
                     creationflags=getattr(subprocess, "DETACHED_PROCESS", 0))


def startup_update(splash=True):
    """Runs before Alpha's window opens: if a newer version is waiting, install it and restart into it.
    Returns True when Alpha should exit because the new version is starting."""
    found = find_update(timeout=4)  # short, so a slow connection barely delays Alpha opening
    if not found:
        return False
    new_ver, data = found
    win = None
    if splash:
        try:
            import tkinter as tk
            win = tk.Tk()
            win.overrideredirect(True)
            win.configure(bg="#0B0D10")
            w, h = 340, 110
            win.geometry(f"{w}x{h}+{(win.winfo_screenwidth() - w) // 2}+{(win.winfo_screenheight() - h) // 2}")
            tk.Label(win, text="α  Alpha Client", fg="#3BA7FF", bg="#0B0D10",
                     font=("Segoe UI", 16, "bold")).pack(pady=(22, 4))
            tk.Label(win, text=f"Updating to {new_ver}…", fg="#E6EDF3", bg="#0B0D10",
                     font=("Segoe UI", 11)).pack()
            win.update()
        except Exception:
            win = None
    try:
        install_update(data)
        time.sleep(0.6)  # long enough to read the splash
        return True
    except Exception:
        _report("Auto-update failed:\n" + traceback.format_exc(), popup=False)
        return False
    finally:
        if win is not None:
            try:
                win.destroy()
            except Exception:
                pass


def load_json(path, default):
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


def save_json(path, data):
    path.write_text(json.dumps(data, indent=2))


TABS = {"Mods": "mod", "Resource Packs": "resourcepack", "Shaders": "shader"}
ALL_TABS = {"Modpacks": "modpack", **TABS}
FOLDERS = {"mod": "mods", "resourcepack": "resourcepacks", "shader": "shaderpacks"}
SORTS = {"Relevance": "relevance", "Downloads": "downloads", "Follows": "follows",
         "Newest": "newest", "Updated": "updated"}
META_LOCK = threading.Lock()


def short(s, n):
    return s if len(s) <= n else s[:n - 1].rstrip() + "…"


def playtime(sec):
    sec = int(sec or 0)
    if sec < 60:
        return "No play time yet"
    if sec < 3600:
        return f"{sec // 60} minute{'s' if sec // 60 != 1 else ''}"
    h = sec // 3600
    return f"{h:,} hour{'s' if h != 1 else ''}"


def ago(ts):
    s = max(0, time.time() - ts)
    for size, unit in ((86400 * 30, "mo"), (86400 * 7, "w"), (86400, "d"), (3600, "h"), (60, "m")):
        if s >= size:
            return f"{int(s // size)}{unit} ago"
    return "just now"


def fmt(n):
    for div, s in ((1e9, "B"), (1e6, "M"), (1e3, "K")):
        if n >= div:
            return f"{n / div:.1f}".rstrip("0").rstrip(".") + s
    return str(n)


# ---------- Modrinth content ----------
def search_projects(query, mc_version, ptype, sort="relevance", offset=0, limit=20):
    facets = [[f"project_type:{ptype}"]]
    if mc_version:  # None = any version (Discover page)
        facets.append([f"versions:{mc_version}"])
    if ptype in ("mod", "modpack"):
        facets.append(["categories:fabric"])
    r = requests.get(f"{MODRINTH}/search", headers=HEADERS, timeout=15,
                     params={"query": query, "limit": limit, "offset": offset, "index": sort,
                             "facets": json.dumps(facets)})
    r.raise_for_status()
    d = r.json()
    return d["hits"], d["total_hits"]


def load_meta(gdir):
    return load_json(gdir / "alpha_content.json", {})


ALPHA_MOD_INDEX = f"https://raw.githubusercontent.com/{GITHUB_REPO}/main/mods/index.json"


def ensure_alpha_mod(gdir, mc_version, say=lambda t: None):
    """Install or update Alpha's in-game mod (the Right Shift menu) for this Minecraft version.
    The list of builds lives in the GitHub repo (mods/index.json). Returns True when the mod is in place."""
    try:
        idx = requests.get(ALPHA_MOD_INDEX, params={"t": int(time.time() // 60)}, headers=HEADERS, timeout=8).json()
        entry = idx.get(mc_version)
        if not entry:
            return False  # no build for this Minecraft version yet
        mods = Path(gdir) / "mods"
        mods.mkdir(parents=True, exist_ok=True)
        target = mods / entry["file"]
        if target.exists() and hashlib.sha1(target.read_bytes()).hexdigest() == entry["sha1"]:
            return True
        url = f"https://raw.githubusercontent.com/{GITHUB_REPO}/main/mods/" + requests.utils.quote(entry["file"])
        data = requests.get(url, headers=HEADERS, timeout=60).content
        if hashlib.sha1(data).hexdigest() != entry["sha1"]:
            return False  # incomplete download: keep whatever was there
        for old in mods.glob("alpha-mod-*.jar*"):
            old.unlink()
        target.write_bytes(data)
        if not any(mods.glob("fabric-api-*.jar")):  # the menu needs Fabric API
            install_project("fabric-api", "mod", mc_version, Path(gdir))
        with META_LOCK:
            meta = load_meta(Path(gdir))
            meta[entry["file"]] = {"title": "Alpha Client (Right Shift menu)", "slug": "", "icon": None, "type": "mod",
                                   "version": entry.get("version", "")}
            save_json(Path(gdir) / "alpha_content.json", meta)
        say(f"Alpha in-game menu {entry.get('version', '')} installed. Press Right Shift in game.")
        return True
    except Exception:
        return False


def install_project(project, ptype, mc_version, gdir, loader="fabric", _seen=None):
    """Download the newest compatible file (plus required mod dependencies)."""
    _seen = _seen if _seen is not None else set()
    if project in _seen:
        return None
    _seen.add(project)
    params = {"game_versions": json.dumps([mc_version])}
    if ptype == "mod":
        params["loaders"] = json.dumps([loader])
    r = requests.get(f"{MODRINTH}/project/{project}/version", headers=HEADERS, params=params, timeout=15)
    r.raise_for_status()
    versions = r.json()
    if not versions:
        return None
    v = versions[0]
    f = next((x for x in v["files"] if x.get("primary")), v["files"][0])
    folder = gdir / FOLDERS[ptype]
    folder.mkdir(parents=True, exist_ok=True)
    dest = folder / f["filename"]
    if not dest.exists() and not (folder / (f["filename"] + ".disabled")).exists():
        dest.write_bytes(requests.get(f["url"], headers=HEADERS, timeout=120).content)
    info = requests.get(f"{MODRINTH}/project/{v['project_id']}", headers=HEADERS, timeout=15).json()
    with META_LOCK:
        meta = load_meta(gdir)
        meta[f["filename"]] = {"title": info.get("title", project), "slug": info.get("slug", project),
                               "icon": info.get("icon_url"), "type": ptype,
                               "version": v.get("version_number", "")}
        save_json(gdir / "alpha_content.json", meta)
    if ptype == "mod":
        for dep in v.get("dependencies", []):
            if dep["dependency_type"] == "required" and dep.get("project_id"):
                install_project(dep["project_id"], "mod", mc_version, gdir, loader, _seen)
    return f["filename"]


# ---------- Microsoft / Minecraft sign-in (device code flow) ----------
MS_SCOPE = "XboxLive.signin offline_access"
MS_BASE = "https://login.microsoftonline.com/consumers/oauth2/v2.0"


def friendly_ms_error(msg):
    m = str(msg)
    low = m.lower()
    if "AADSTS70002" in m or "AADSTS7000218" in m or "public client" in low:
        return ("Your Azure app doesn't allow public client flows.\nIn Azure: Authentication > Advanced settings > "
                "'Allow public client flows' = Yes, then Save.")
    if "AADSTS700016" in m or "AADSTS90002" in m or "AADSTS700025" in m:
        return ("Microsoft doesn't recognize that client ID.\nCopy the 'Application (client) ID' from your app's "
                "Overview page in Azure.")
    if "AADSTS50194" in m or "AADSTS700054" in m or "AADSTS50020" in m or "consumers" in low:
        return ("The Azure app must allow personal Microsoft accounts.\nCreate it with 'Personal Microsoft accounts only'.")
    return m


def ms_device_start(cid):
    r = requests.post(f"{MS_BASE}/devicecode", data={"client_id": cid, "scope": MS_SCOPE}, timeout=15)
    d = r.json()
    if "device_code" not in d:
        raise RuntimeError(friendly_ms_error(d.get("error_description", "Microsoft rejected the client ID")))
    return d


def ms_device_poll(cid, dev, cancel):
    end = time.time() + dev["expires_in"]
    interval = dev.get("interval", 5)
    while time.time() < end and not cancel.is_set():
        time.sleep(interval)
        d = requests.post(f"{MS_BASE}/token", timeout=15, data={
            "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
            "client_id": cid, "device_code": dev["device_code"]}).json()
        if "access_token" in d:
            return d
        err = d.get("error")
        if err == "authorization_pending":
            continue
        if err == "slow_down":
            interval += 5
            continue
        raise RuntimeError(friendly_ms_error(d.get("error_description", err)))
    raise RuntimeError("Sign-in was cancelled or timed out.")


def ms_refresh(cid, refresh_token):
    d = requests.post(f"{MS_BASE}/token", timeout=15, data={
        "grant_type": "refresh_token", "client_id": cid,
        "refresh_token": refresh_token, "scope": MS_SCOPE}).json()
    if "access_token" not in d:
        raise RuntimeError(d.get("error_description", "refresh failed"))
    return d


def minecraft_login(ms_token):
    h = {"Content-Type": "application/json", "Accept": "application/json"}
    xbl = requests.post("https://user.auth.xboxlive.com/user/authenticate", headers=h, timeout=15, json={
        "Properties": {"AuthMethod": "RPS", "SiteName": "user.auth.xboxlive.com", "RpsTicket": "d=" + ms_token},
        "RelyingParty": "http://auth.xboxlive.com", "TokenType": "JWT"})
    xbl.raise_for_status()
    xbl = xbl.json()
    uhs = xbl["DisplayClaims"]["xui"][0]["uhs"]
    xsts = requests.post("https://xsts.auth.xboxlive.com/xsts/authorize", headers=h, timeout=15, json={
        "Properties": {"SandboxId": "RETAIL", "UserTokens": [xbl["Token"]]},
        "RelyingParty": "rp://api.minecraftservices.com/", "TokenType": "JWT"})
    if xsts.status_code == 401:
        code = xsts.json().get("XErr")
        raise RuntimeError({2148916233: "This Microsoft account has no Xbox profile. Sign in once at minecraft.net to create one.",
                            2148916238: "Child accounts must be added to a Microsoft Family by an adult."
                            }.get(code, f"Xbox error {code}"))
    xsts.raise_for_status()
    xsts = xsts.json()
    mc = requests.post("https://api.minecraftservices.com/authentication/login_with_xbox", headers=h, timeout=15,
                       json={"identityToken": f"XBL3.0 x={uhs};{xsts['Token']}"})
    if mc.status_code == 403:
        raise RuntimeError("Mojang hasn't approved this Azure app yet (error 403).\n\nSubmit it at https://aka.ms/mce-reviewappid and wait for approval (reviewed weekly). Until then you can play offline.")
    mc.raise_for_status()
    token = mc.json()["access_token"]
    prof = requests.get("https://api.minecraftservices.com/minecraft/profile", timeout=15,
                        headers={"Authorization": "Bearer " + token})
    if prof.status_code == 404:
        raise RuntimeError("This account doesn't own Minecraft: Java Edition.")
    prof.raise_for_status()
    p = prof.json()
    return {"username": p["name"], "uuid": p["id"], "token": token}


def search_any(query):
    facets = [["project_type:mod", "project_type:modpack"], ["categories:fabric"]]
    r = requests.get(f"{MODRINTH}/search", headers=HEADERS, timeout=15,
                     params={"query": query, "limit": 10, "facets": json.dumps(facets)})
    r.raise_for_status()
    return r.json()["hits"]


def newest_mc(versions):
    rel = [v for v in versions if re.fullmatch(r"\d+\.\d+(\.\d+)?", v)]
    return max(rel, key=lambda v: tuple(int(x) for x in v.split("."))) if rel else versions[-1]


def mrpack_info(path):
    with zipfile.ZipFile(path) as z:
        return json.loads(z.read("modrinth.index.json"))


def install_mrpack(path, gdir, say=lambda t: None):
    """Install a Modrinth .mrpack (mods, packs and overrides) into an instance folder."""
    gdir.mkdir(parents=True, exist_ok=True)
    base = gdir.resolve()
    with zipfile.ZipFile(path) as z:
        files = json.loads(z.read("modrinth.index.json")).get("files", [])
        for i, f in enumerate(files):
            if f.get("env", {}).get("client") == "unsupported":
                continue
            dest = (gdir / f["path"]).resolve()
            if base not in dest.parents:  # never write outside the instance
                continue
            say(f"Downloading {dest.name} ({i + 1}/{len(files)})")
            data = None
            for url in f.get("downloads", []):
                try:
                    data = requests.get(url, headers=HEADERS, timeout=120).content
                    break
                except Exception:
                    continue
            if data is None:
                raise RuntimeError(f"Couldn't download {dest.name}")
            sha = f.get("hashes", {}).get("sha512")
            if sha and hashlib.sha512(data).hexdigest() != sha:
                raise RuntimeError(f"Download of {dest.name} was corrupted, please try again.")
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_bytes(data)
        say("Applying pack files…")
        for prefix in ("overrides/", "client-overrides/"):
            for n in z.namelist():
                if n.startswith(prefix) and not n.endswith("/"):
                    dest = (gdir / n[len(prefix):]).resolve()
                    if base in dest.parents:
                        dest.parent.mkdir(parents=True, exist_ok=True)
                        dest.write_bytes(z.read(n))


def read_import(folder):
    """Detect a Prism/MultiMC or CurseForge instance. Returns (name, mc, loader, source) or None."""
    f = Path(folder)
    name, mc, loader = f.name, None, "vanilla"
    if (f / "mmc-pack.json").exists():
        for c in load_json(f / "mmc-pack.json", {}).get("components", []):
            uid = c.get("uid", "")
            if uid == "net.minecraft":
                mc = c.get("version")
            elif uid == "net.fabricmc.fabric-loader":
                loader = "fabric"
            elif uid in ("net.minecraftforge", "net.neoforged", "org.quiltmc.quilt-loader"):
                loader = "unsupported"
        src = next((f / s for s in (".minecraft", "minecraft") if (f / s).exists()), f)
    elif (f / "manifest.json").exists():
        m = load_json(f / "manifest.json", {}).get("minecraft", {})
        mc = m.get("version")
        name = load_json(f / "manifest.json", {}).get("name", name)
        ids = [x.get("id", "") for x in m.get("modLoaders", [])]
        loader = "fabric" if any("fabric" in i for i in ids) else ("unsupported" if ids else "vanilla")
        src = f / "overrides" if (f / "overrides").exists() else f
    else:
        return None
    return name, mc, loader, src


