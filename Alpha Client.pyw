        top.pack(fill="x", padx=16, pady=(14, 6))
        st = ctk.CTkLabel(top, text="", font=(FONT, 13, "bold"), anchor="w", wraplength=330, justify="left")
        st.pack(side="left", fill="x", expand=True)
        pct = ctk.CTkLabel(top, text="", text_color=MUTED, font=("Consolas", 12))
        pct.pack(side="right")
