            threading.Thread(target=self._load_current_skin, daemon=True).start()

    def _skins(self):
        return load_json(SKINS_DIR / "skins.json", [])

    def _save_skins(self, data):
        SKINS_DIR.mkdir(parents=True, exist_ok=True)
        save_json(SKINS_DIR / "skins.json", data)

    def _load_current_skin(self):
        """Fetch the skin this Microsoft account is wearing right now."""
        try:
            r = requests.get("https://api.minecraftservices.com/minecraft/profile", timeout=10,
                             headers={"Authorization": "Bearer " + self.auth["token"]})
            r.raise_for_status()
            s = next((s for s in r.json().get("skins", []) if s.get("state") == "ACTIVE"), None)
            if s:
                data = requests.get(s["url"], timeout=10).content
                self._current_skin = {"id": "current", "name": "Current skin", "variant": s.get("variant", "CLASSIC").lower(),
                                      "png": data}
                self.after(0, self.render_skins)
        except Exception:
            pass

    def render_skins(self):
        parent = self.skin_grid_parent
        if not parent.winfo_exists():
            return
        for w in parent.winfo_children():
            w.destroy()
        skins = self._skins()
        cur = getattr(self, "_current_skin", None)
        ctk.CTkLabel(parent, text="⌃  Saved skins", font=(FONT, 16, "bold")).pack(anchor="w", padx=8, pady=(8, 8))
        grid = ctk.CTkFrame(parent, fg_color="transparent")
        grid.pack(anchor="w")
        tiles = [None] + ([cur] if cur else []) + skins
        for i, s in enumerate(tiles):
            t = ctk.CTkFrame(grid, width=112, height=150, corner_radius=14, fg_color=CARD, border_width=2,
                             border_color=ACCENT if s and self._skin_sel == s["id"] else CARD, cursor="hand2")
            t.grid(row=i // 4, column=i % 4, padx=5, pady=5)
            t.pack_propagate(False)
            if s is None:
                ctk.CTkLabel(t, text="＋", font=(FONT, 28)).pack(pady=(34, 0))
                ctk.CTkLabel(t, text="Add skin", font=(FONT, 13, "bold")).pack()
                ctk.CTkLabel(t, text="PNG, 64×64", text_color=MUTED, font=(FONT, 11)).pack()
                cmd = self.add_skin
            else:
                im = skin_preview(s["png"] if "png" in s else (SKINS_DIR / f"{s['id']}.png").read_bytes(),
                                  s.get("variant") == "slim", 6)
                if im:
                    ctk.CTkLabel(t, text="", image=ctk.CTkImage(light_image=im, dark_image=im,
                                                                size=(im.width // 2, im.height // 2))).pack(pady=(8, 2))
                ctk.CTkLabel(t, text=short(s["name"], 14), font=(FONT, 11, "bold"),
                             text_color=ACCENT if s["id"] == "current" else TEXT).pack()
                cmd = lambda s=s: self.select_skin(s)  # noqa: E731
            for w in (t, *t.winfo_children()):
                w.bind("<Button-1>", lambda e, c=cmd: c())
        if not skins:
            ctk.CTkLabel(parent, text="Add a skin file to save it here. Skins from sites like NameMC or the "
                                      "Minecraft Skin editor work.", text_color=MUTED, wraplength=460,
                         justify="left").pack(anchor="w", padx=8, pady=10)
        pick = next((s for s in tiles if s and s["id"] == self._skin_sel), None) or cur or (skins[0] if skins else None)
        self._show_skin(pick)

    def _show_skin(self, s):
        for w in self.skin_actions.winfo_children():
            w.destroy()
        name = self.auth["username"] if self.auth else "Player"
        self.skin_name.configure(text=name)
        if not s:
            self.skin_big.configure(image=None, text="No skin selected", text_color=MUTED)
            return
        data = s["png"] if "png" in s else (SKINS_DIR / f"{s['id']}.png").read_bytes()
        im = skin_preview(data, s.get("variant") == "slim", 10)
        if im:
            self.skin_big.configure(image=ctk.CTkImage(light_image=im, dark_image=im, size=(im.width // 2, im.height // 2)),
                                    text="")
        ctk.CTkLabel(self.skin_actions, text=short(s["name"], 22), font=(FONT, 14, "bold")).pack()
        if s["id"] == "current":
            ctk.CTkLabel(self.skin_actions, text="You're wearing this skin.", text_color=MUTED).pack(pady=(2, 0))
            return
        seg = ctk.CTkSegmentedButton(self.skin_actions, values=["Classic arms", "Slim arms"], selected_color=ACCENT,
                                     selected_hover_color=HOVER, unselected_color=CARD, text_color=TEXT,
                                     command=lambda v: self._skin_variant(s, "slim" if v.startswith("Slim") else "classic"))
        seg.set("Slim arms" if s.get("variant") == "slim" else "Classic arms")
        seg.pack(pady=8)
        self.btn(self.skin_actions, "Use this skin", lambda: self.apply_skin(s), height=38).pack(fill="x", pady=(4, 6))
        self.btn(self.skin_actions, "Delete", lambda: self._delete_skin(s), flat=True, height=34).pack(fill="x")

    def select_skin(self, s):
        self._skin_sel = s["id"]
        self.render_skins()

    def add_skin(self):
        from tkinter import filedialog
        path = filedialog.askopenfilename(title="Choose a skin file", filetypes=[("Minecraft skin", "*.png")])
        if not path:
            return
        try:
            im = Image.open(path)
            if im.size not in ((64, 64), (64, 32)):
                raise ValueError(f"Skins must be 64×64 or 64×32 pixels. This image is {im.width}×{im.height}.")
        except Exception as e:
            self.notice("That isn't a skin file", str(e))
            return
        sid = uuid.uuid4().hex[:10]
        SKINS_DIR.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, SKINS_DIR / f"{sid}.png")
        # guess slim arms: the 4th arm column is transparent on slim skins
        px = im.convert("RGBA").load()
        slim = im.size == (64, 64) and px[47, 25][3] == 0
        data = self._skins() + [{"id": sid, "name": Path(path).stem[:24], "variant": "slim" if slim else "classic"}]
        self._save_skins(data)
        self._skin_sel = sid
        self.render_skins()

    def _skin_variant(self, s, v):
        data = self._skins()
        for x in data:
            if x["id"] == s["id"]:
                x["variant"] = v
        self._save_skins(data)
        self._skin_sel = s["id"]
        self.render_skins()

    def _delete_skin(self, s):
        def go():
            self._save_skins([x for x in self._skins() if x["id"] != s["id"]])
            (SKINS_DIR / f"{s['id']}.png").unlink(missing_ok=True)
            self._skin_sel = None
            self.render_skins()

        self.notice("Delete skin?", f"\"{s['name']}\" will be removed from your saved skins.",
                    [("Delete", go, False)], close="Cancel")

    def apply_skin(self, s):
        if not self.auth or self.auth.get("offline") or not self.auth.get("token"):
            self.notice("Sign in with Microsoft first",
                        "Skins are stored on your Minecraft account, so changing them needs Microsoft sign-in. "
                        "Your saved skins stay here until then.",
                        [("Sign in", self.signin_dialog, False)], close="Later")
            return
        self.say(f"Uploading {s['name']}…")

        def work():
            try:
                r = requests.post("https://api.minecraftservices.com/minecraft/profile/skins", timeout=20,
                                  headers={"Authorization": "Bearer " + self.auth["token"]},
                                  data={"variant": s.get("variant", "classic")},
                                  files={"file": ("skin.png", (SKINS_DIR / f"{s['id']}.png").read_bytes(), "image/png")})
                if r.status_code == 401:
                    raise RuntimeError("Your sign-in has expired. Press Play once or sign in again, then retry.")
                r.raise_for_status()
                self.say(f"Skin changed to {s['name']}. It shows up in game the next time you join a world.")
                self._load_current_skin()
            except Exception as e:
                msg = str(e)
                self.after(0, lambda: self.notice("Couldn't change your skin", msg))

        threading.Thread(target=work, daemon=True).start()

    # ---------- launch ----------
    def play(self, p):
        if not self.auth:
            self.signin_dialog()
            return
        threading.Thread(target=self._play, args=(p,), daemon=True).start()

    def _play(self, p):
        try:
            gdir = self.game_dir(p)
            gdir.mkdir(parents=True, exist_ok=True)
            state = {"max": 1}
            cb = {"setStatus": self.say, "setMax": lambda m: state.update(max=max(m, 1)),
                  "setProgress": lambda v: self.progress(v / state["max"])}
            if not p["installed"]:
                self.say("Installing Minecraft…")
                if p["loader"] == "fabric":
                    mll.fabric.install_fabric(p["version"], str(MC_DIR), callback=cb)
                else:
                    mll.install.install_minecraft_version(p["version"], str(MC_DIR), callback=cb)
                if p["loader"] == "fabric" and p.get("pack"):
                    for i, slug in enumerate(ALPHA_PACK):
                        self.say(f"Alpha Pack: {slug}")
                        self.progress(i / len(ALPHA_PACK))
                        try:
                            install_project(slug, "mod", p["version"], gdir)
                        except Exception:
                            pass
                p["installed"] = True
            if p["loader"] == "fabric" and self.config_data.get("alpha_mod", True):
                self.say("Checking the Alpha in-game menu…")
                ensure_alpha_mod(gdir, p["version"], self.say)
            auth = self.auth
            if not auth.get("offline") and auth.get("refresh") and self.client_id():
                try:
                    tok = ms_refresh(self.client_id(), auth["refresh"])
                    auth.update(minecraft_login(tok["access_token"]))
                    auth["refresh"] = tok.get("refresh_token", auth["refresh"])
                    save_json(AUTH_FILE, auth)
                except Exception as e:
                    self.say(f"Session expired - please sign in again. ({e})")
                    return
            vid = p["version"]
            if p["loader"] == "fabric":
                vid = f"fabric-loader-{mll.fabric.get_latest_loader_version()}-{p['version']}"
            opts = {"username": auth["username"], "uuid": auth.get("uuid") or str(uuid.uuid4()),
                    "token": auth.get("token", ""), "gameDirectory": str(gdir),
                    "jvmArguments": [f"-Xmx{p['ram']}G", f"-Xms{max(1, p['ram'] // 2)}G"]}
            cfg = self.config_data
            # per-instance settings (instance Settings window) override Alpha's defaults
            opts["jvmArguments"] += cfg.get("jvm_args", "").split() + p.get("jvm_args", "").split()
            java = p.get("java_path") or cfg.get("java_path")
            if java:
                opts["executablePath"] = java
            w, h = str(p.get("win_w") or cfg.get("win_w", "")), str(p.get("win_h") or cfg.get("win_h", ""))
            if w.isdigit() and h.isdigit():
                opts.update(customResolution=True, resolutionWidth=w, resolutionHeight=h)
            write_options(gdir, {"fullscreen": "true" if p.get("fullscreen") else "false"})
            cmd = mll.command.get_minecraft_command(vid, str(MC_DIR), opts)
            env = dict(os.environ, INST_NAME=p["name"], INST_ID=p["id"], INST_DIR=str(gdir),
                       INST_MC_VERSION=p["version"])
            hidden = getattr(subprocess, "CREATE_NO_WINDOW", 0)
            if p.get("hook_pre"):
                self.say("Running pre-launch command…")
                r = subprocess.run(p["hook_pre"], shell=True, cwd=str(gdir), env=env, creationflags=hidden)
                if r.returncode != 0:
                    self.say(f"Pre-launch command failed (exit code {r.returncode}), so the game wasn't started")
                    return
            if p.get("hook_wrapper"):
                import shlex
                cmd = shlex.split(p["hook_wrapper"], posix=False) + cmd
            p["last_played"] = time.time()
            save_json(PROFILES_FILE, self.profiles)
            self.progress(1)
            self.game = subprocess.Popen(cmd, cwd=str(gdir), env=env, creationflags=hidden)
            self._post_hook = (p.get("hook_post"), str(gdir), env)
            self.game_name = p["name"]
            self._tick, self.game_profile = time.time(), p
            self.say(f"{p['name']} is running")
            if self.config_data.get("minimize"):
                self.after(0, self.iconify)
        except Exception as e:
            self.say(f"Error: {e}")

    # ---------- sign in ----------
    def signin_dialog(self):
        d = Dialog(self, 440, 540)
        self.dialog_header(d, "Sign in")
        if self.logo_big:
            ctk.CTkLabel(d, text="", image=self.logo_big).pack(pady=(24, 0))
        else:
            ctk.CTkLabel(d, text="α", font=(FONT, 48, "bold"), text_color=ACCENT).pack(pady=(24, 0))
        ctk.CTkLabel(d, text="Sign in to Alpha", font=(FONT, 22, "bold")).pack()
        ctk.CTkLabel(d, text="Use your Microsoft account, or play offline.", text_color=MUTED).pack(pady=(2, 18))
        self.btn(d, "Sign in with Microsoft", lambda: (d.destroy(), self.microsoft_login()), height=42
                 ).pack(padx=30, fill="x")
        hint = {"none": "Needs a one-time setup first. Click it to start.",
                "waiting": "Set up. Works once Mojang approves Alpha."}.get(self.ms_status())
        if hint:
            ctk.CTkLabel(d, text=hint, text_color=MUTED, font=(FONT, 11)).pack(pady=(4, 0))
        ctk.CTkLabel(d, text="— or —", text_color=MUTED).pack(pady=12)
        e = ctk.CTkEntry(d, placeholder_text="Offline username", height=40, corner_radius=10,
                         fg_color=CARD, border_color=LINE)
        e.pack(padx=30, fill="x")
        if self.auth:
            e.insert(0, self.auth["username"])

        def offline():
            self.auth = {"username": e.get().strip() or "AlphaPlayer", "offline": True}
            save_json(AUTH_FILE, self.auth)
            d.destroy()
            self.build_side()

        self.btn(d, "Continue offline", offline, flat=True, height=38).pack(padx=30, pady=10, fill="x")

    def client_id(self):
        return BUILTIN_CLIENT_ID or self.config_data.get("ms_client_id", "")

    def ms_status(self):
        """'none' (no client ID), 'waiting' (ID saved, Mojang not confirmed yet) or 'working'."""
        if not self.client_id():
            return "none"
        return "working" if self.config_data.get("ms_working") else "waiting"

    def ms_setup_dialog(self, step=0):
        """Step-by-step guide for the one-time Azure + Mojang setup, all inside Alpha."""
        d = Dialog(self, 560, 560)
        self.dialog_header(d, "Set up Microsoft sign-in")
        dots = ctk.CTkFrame(d, fg_color="transparent")
        dots.pack(anchor="w", padx=30, pady=(16, 0))
        body = ctk.CTkFrame(d, fg_color="transparent")
        body.pack(fill="both", expand=True, padx=30, pady=(10, 0))
        nav = ctk.CTkFrame(d, fg_color="transparent")
        nav.pack(fill="x", padx=24, pady=20)
        state = {"step": step}

        def text(t, muted=True, size=13, pady=(0, 10)):
            ctk.CTkLabel(body, text=t, text_color=MUTED if muted else TEXT, justify="left", wraplength=480,
                         font=(FONT, size)).pack(anchor="w", pady=pady)

        def title(t):
            ctk.CTkLabel(body, text=t, font=(FONT, 18, "bold")).pack(anchor="w", pady=(0, 6))

        def copy_row(label, value):
            row = ctk.CTkFrame(body, fg_color=CARD, corner_radius=10)
            row.pack(fill="x", pady=4)
            ctk.CTkLabel(row, text=label, text_color=MUTED, width=120, anchor="w").pack(side="left", padx=(14, 0), pady=10)
            ctk.CTkLabel(row, text=value, font=(FONT, 13, "bold"), anchor="w").pack(side="left", fill="x", expand=True)
            self.btn(row, "Copy", lambda: (self.clipboard_clear(), self.clipboard_append(value),
                                           self.say(f"Copied {value}")), flat=True, width=64, height=28
                     ).pack(side="right", padx=8)

        def step_create():
            title("1.  Create a free Azure app")
            text("Minecraft only accepts sign-ins from apps Microsoft knows about, so Alpha needs one of its own. "
                 "Sign in to Azure with any Microsoft account and click New registration.")
            copy_row("Name", "Alpha Client")
            copy_row("Account types", "Personal Microsoft accounts only")
            copy_row("Redirect URI", "Leave it empty")
            text("The name can't contain \"Minecraft\" or \"Mojang\". Then click Register.", pady=(10, 10))
            self.btn(body, "Open Azure portal", lambda: webbrowser.open(
                "https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade"),
                height=40).pack(anchor="w")

        def step_public():
            title("2.  Allow sign-in from apps like Alpha")
            text("In your new app, open Authentication in the left menu. Under Advanced settings, set "
                 "\"Allow public client flows\" to Yes, then click Save.")
            text("This lets Alpha show you a short code to sign in with, so it never sees your password.")

        def step_id():
            title("3.  Paste your client ID")
            text("Open Overview in your Azure app and copy the Application (client) ID. It looks like "
                 "1a2b3c4d-1234-5678-9abc-1234567890ab.")
            e = ctk.CTkEntry(body, height=40, corner_radius=10, fg_color=CARD, border_color=LINE,
                             placeholder_text="Application (client) ID")
            e.pack(fill="x", pady=(4, 8))
            if self.client_id():
                e.insert(0, self.client_id())
            result = ctk.CTkLabel(body, text="", justify="left", wraplength=480)
            result.pack(anchor="w")

            def check():
                cid = e.get().strip()
                if not re.fullmatch(r"[0-9a-fA-F-]{36}", cid):
                    result.configure(text="That doesn't look like a client ID. Copy the whole thing from Overview.",
                                     text_color="#FF6B6B")
                    return
                result.configure(text="Checking…", text_color=MUTED)

                def work():
                    try:
                        ms_device_start(cid)
                        ok, msg = True, "Looks good. Your Azure app is set up correctly."
                    except Exception as ex:
                        ok, msg = False, str(ex)

                    def show():
                        if ok:
                            self.config_data["ms_client_id"] = cid
                            self.config_data.pop("ms_working", None)
                            self.save_cfg()
                        if result.winfo_exists():
                            result.configure(text=msg, text_color="#1BD96A" if ok else "#FF6B6B")
                    self.after(0, show)

                threading.Thread(target=work, daemon=True).start()

            self.btn(body, "Check and save", check, height=38, width=150).pack(anchor="w", pady=(4, 0))

        def step_mojang():
            title("4.  Ask Mojang to approve Alpha")
            text("Last step. Mojang has to approve every new app before it can sign players in to Minecraft. "
                 "Fill in their form with the details from your app's Overview page.")
            if self.client_id():
                copy_row("Client ID", self.client_id())
            copy_row("App name", "Alpha Client")
            text("Reviews happen about once a week. Until then, play offline. When you're approved, "
                 "click Sign in with Microsoft and it will just work.", pady=(10, 10))
            self.btn(body, "Open Mojang approval form", lambda: webbrowser.open("https://aka.ms/mce-reviewappid"),
                     height=40).pack(anchor="w")

        steps = [step_create, step_public, step_id, step_mojang]

        def render():
            for w in (*dots.winfo_children(), *body.winfo_children(), *nav.winfo_children()):
                w.destroy()
            i = state["step"]
            for n in range(len(steps)):
                ctk.CTkFrame(dots, width=26 if n == i else 8, height=8, corner_radius=4,
                             fg_color=ACCENT if n <= i else LINE).pack(side="left", padx=3)
            steps[i]()
            if i > 0:
                self.btn(nav, "Back", lambda: go(-1), flat=True, width=90, height=38).pack(side="left")
            if i < len(steps) - 1:
                self.btn(nav, "Next", lambda: go(1), width=110, height=38).pack(side="right")
            else:
                self.btn(nav, "Done", d.destroy, width=110, height=38).pack(side="right")

        def go(delta):
            state["step"] = max(0, min(len(steps) - 1, state["step"] + delta))
            render()

        render()

    def notice(self, title, text, buttons=(), close="OK"):
        """Small in-app message box. buttons: (label, command, flat) tuples; a close button is always added."""
        d = Dialog(self, 460, 300)
        self.dialog_header(d, title)
        ctk.CTkLabel(d, text=text, justify="left", wraplength=400).pack(anchor="w", padx=30, pady=(22, 0))
        row = ctk.CTkFrame(d, fg_color="transparent")
        row.pack(side="bottom", anchor="e", padx=24, pady=20)
        for label, cmd, flat in buttons:
            self.btn(row, label, lambda c=cmd: (d.destroy(), c()), flat=flat, height=36).pack(side="left", padx=(0, 8))
        self.btn(row, close, d.destroy, flat=bool(buttons), width=80, height=36).pack(side="left")
        return d

    def microsoft_login(self):
        cid = self.client_id()
        if not cid:
            self.ms_setup_dialog()
            return
        try:
            dev = ms_device_start(cid)
        except Exception as e:
            self.notice("Couldn't start sign-in", str(e),
                        [("Fix setup", lambda: self.ms_setup_dialog(2), False)])
            return
        cancel = threading.Event()
        d = Dialog(self, 480, 420)
        self.dialog_header(d, "Sign in with Microsoft")

        def copy():
            self.clipboard_clear()
            self.clipboard_append(dev["user_code"])

        copy()  # already on the clipboard, so you can paste it straight into the browser
        ctk.CTkLabel(d, text="Enter this code on the Microsoft page that just opened.\nIt's already copied.",
                     text_color=MUTED, justify="center").pack(pady=(24, 12))
        box = ctk.CTkFrame(d, fg_color=CARD, corner_radius=14, border_width=1, border_color=LINE)
        box.pack(padx=40, fill="x")
        ctk.CTkLabel(box, text=dev["user_code"], font=("Consolas", 34, "bold"), text_color=ACCENT).pack(pady=16)
        self.btn(d, "Open sign-in page again", lambda: webbrowser.open(dev["verification_uri"]),
                 height=40).pack(padx=40, pady=(18, 6), fill="x")
        self.btn(d, "Copy code", copy, flat=True, height=36).pack(padx=40, fill="x")
        ctk.CTkLabel(d, text="Waiting for you to finish in the browser…", text_color=MUTED,
                     font=(FONT, 12)).pack(pady=12)

        d.on_close = cancel.set
        webbrowser.open(dev["verification_uri"])

        def run():
            try:
                tok = ms_device_poll(cid, dev, cancel)
                self.say("Signing in to Minecraft…")
                prof = minecraft_login(tok["access_token"])
                prof.update(refresh=tok.get("refresh_token"), offline=False)
                save_json(AUTH_FILE, prof)
                self.auth = prof
                self.config_data["ms_working"] = True
                self.save_cfg()
                self.after(0, lambda: (d.winfo_exists() and d.destroy(), self.build_side()))
                self.say(f"Signed in as {prof['username']}")
            except Exception as e:
                if cancel.is_set():
                    return
                msg = str(e)
                if "hasn't approved" in msg:
                    title, msg = "Waiting for Mojang", ("Your Microsoft account is fine, but Mojang hasn't approved "
                                                        "Alpha yet. Reviews happen about once a week. Play offline "
                                                        "until then.")
                    extra = [("Play offline", self.signin_dialog, True)]
                else:
                    title, extra = "Sign-in failed", []
                self.after(0, lambda: (d.winfo_exists() and d.destroy(), self.notice(title, msg, extra)))

        threading.Thread(target=run, daemon=True).start()

    # ---------- settings ----------
    def bind_click(self, w, cmd):
        w.bind("<Button-1>", lambda e: cmd())
        for ch in w.winfo_children():
            self.bind_click(ch, cmd)

    def save_cfg(self):
        save_json(CONFIG_FILE, self.config_data)

    def set_theme(self, theme=None, accent=None):
        self.config_data["theme"] = theme or self.config_data.get("theme", "Dark")
        self.config_data["accent"] = accent or self.config_data.get("accent", "Blue")
        self.save_cfg()
        self.apply_theme(self.config_data["theme"], self.config_data["accent"])
        self.build_ui()
        self.show_settings("Appearance")

