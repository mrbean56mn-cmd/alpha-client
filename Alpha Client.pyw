        seg.pack(anchor="w", padx=20, pady=10)
        self.mod_area = ctk.CTkFrame(pg, fg_color="transparent")
        self.mod_area.pack(fill="x", padx=14)
        self.render_modules(p, cats[0])

    def render_modules(self, p, cat):
        for w in self.mod_area.winfo_children():
            w.destroy()
        opts = read_options(self.game_dir(p))
        if cat == "Performance":
            self.performance_panel(p, opts)
        if cat != "Game" and p["loader"] != "fabric":
            ctk.CTkLabel(self.mod_area, text="Mod modules need a Fabric instance.", text_color=MUTED).pack(
                anchor="w", padx=8, pady=6)
        grid = ctk.CTkFrame(self.mod_area, fg_color="transparent")
        grid.pack(fill="x")
        grid.grid_columnconfigure((0, 1), weight=1, uniform="m")
        i = 0
        for m in MODULES:
            if m["cat"] != cat:
                continue
            card = ctk.CTkFrame(grid, fg_color=CARD, corner_radius=14)
            card.grid(row=i // 2, column=i % 2, padx=6, pady=6, sticky="ew")
            i += 1
            row = ctk.CTkFrame(card, fg_color="transparent")
            row.pack(fill="x", padx=16, pady=(14, 0))
            ctk.CTkLabel(row, text=m["title"], font=(FONT, 15, "bold")).pack(side="left")
            sw = ctk.CTkSwitch(row, text="", width=46, progress_color=ACCENT)
            if self.module_on(p, m, opts):
                sw.select()
            if m["kind"] == "mod" and p["loader"] != "fabric":
                sw.configure(state="disabled")
            sw.configure(command=lambda m=m, sw=sw: self.toggle_module(p, m, sw))
            sw.pack(side="right")
            ctk.CTkLabel(card, text=m["desc"], text_color=MUTED, justify="left", wraplength=290,
                         anchor="w").pack(anchor="w", padx=16, pady=(2, 14))

    def performance_panel(self, p, opts):
        gdir = self.game_dir(p)
        card = ctk.CTkFrame(self.mod_area, fg_color=CARD, corner_radius=14)
        card.pack(fill="x", padx=6, pady=6)
        ctk.CTkLabel(card, text="Game performance", font=(FONT, 16, "bold")).pack(anchor="w", padx=16, pady=(14, 0))
        ctk.CTkLabel(card, text="Changes apply the next time you launch this instance.",
                     text_color=MUTED).pack(anchor="w", padx=16)
        row = ctk.CTkFrame(card, fg_color="transparent")
        row.pack(anchor="w", padx=16, pady=10)

        def preset(n):
            write_options(gdir, PRESETS[n])
            self.say(f"{n} preset applied")
            self.render_modules(p, "Performance")

        for n in PRESETS:
            self.btn(row, n, lambda n=n: preset(n), flat=True, width=110, height=34).pack(side="left", padx=(0, 8))
        for label, key, lo, hi, default in (("Render distance", "renderDistance", 2, 32, 12),
                                            ("Simulation distance", "simulationDistance", 5, 32, 12),
                                            ("Max FPS", "maxFps", 30, 260, 120)):
            try:
                cur = int(opts.get(key, default))
            except ValueError:
                cur = default
            cur = min(max(cur, lo), hi)
            r = ctk.CTkFrame(card, fg_color="transparent")
            r.pack(fill="x", padx=16, pady=(0, 10))
            show = lambda v: "Unlimited" if int(v) >= 260 and key == "maxFps" else str(int(v))  # noqa: E731
            lab = ctk.CTkLabel(r, text=f"{label}: {show(cur)}", width=220, anchor="w")
            lab.pack(side="left")

            def on(v, key=key, label=label, lab=lab, show=show):
                lab.configure(text=f"{label}: {show(v)}")
                write_options(gdir, {key: str(int(v))})

            s = ctk.CTkSlider(r, from_=lo, to=hi, number_of_steps=hi - lo, width=340, progress_color=ACCENT, command=on)
            s.set(cur)
            s.pack(side="left")

    def toggle_module(self, p, m, sw):
        on = bool(sw.get())
        gdir = self.game_dir(p)
        if m["kind"] == "opt":
            key, v_on, v_off, _ = m["data"]
            write_options(gdir, {key: v_on if on else v_off})
            self.say(f"{m['title']} {'on' if on else 'off'} (applies next launch)")
            return
        slug = m["data"][0]
        files = self.module_files(p, slug)

        def work():
            try:
                if files:
                    for f in files:
                        if on and f.name.endswith(".disabled"):
                            f.rename(f.with_name(f.name[:-9]))
                        elif not on and not f.name.endswith(".disabled"):
                            f.rename(f.with_name(f.name + ".disabled"))
                    self.say(f"{m['title']} {'enabled' if on else 'disabled'}")
                elif on:
                    self.say(f"Installing {m['title']}…")
                    if not install_project(slug, "mod", p["version"], gdir):
                        raise RuntimeError(f"no build for Minecraft {p['version']} yet")
                    self.say(f"{m['title']} installed")
            except Exception as e:
                msg = "couldn't find it on Modrinth" if "404" in str(e) else str(e)
                self.say(f"{m['title']}: {msg}")
                self.after(0, lambda: sw.winfo_exists() and sw.deselect())

        threading.Thread(target=work, daemon=True).start()

