    def duplicate_instance(self, p, d):
        q = dict(p, id=uuid.uuid4().hex[:8], name=(p["name"] + " (copy)")[:40], playtime=0)
        q.pop("last_played", None)
        src, dst = self.game_dir(p), self.game_dir(q)
        d.destroy()
        self.say(f"Duplicating {p['name']}…")

        def work():
            if src.exists():
                shutil.copytree(src, dst)
            self.profiles.append(q)
            self._save_profiles()
            self.say(f"Made {q['name']}")
            self.after(0, lambda: (self.build_rail(), self.show_instance(q)))

        self.run_task(work)

    def iset_install(self, p, c, d):
        self._iset_h(c, "Installation info")
        card = ctk.CTkFrame(c, fg_color=CARD, corner_radius=12)
        card.pack(fill="x", padx=12, pady=4)
        for k, v in (("Platform", p["loader"].title()), ("Game version", p["version"]),
                     ("Fabric loader", "Latest (picked automatically)" if p["loader"] == "fabric" else "None")):
            r = ctk.CTkFrame(card, fg_color="transparent")
            r.pack(fill="x", padx=14, pady=3)
            ctk.CTkLabel(r, text=k, text_color=MUTED).pack(side="left")
            ctk.CTkLabel(r, text=v, font=(FONT, 13, "bold")).pack(side="right")

        self._iset_h(c, "Edit installation", "Changing the version or platform after adding content can break "
                                             "mods that don't support it. Alpha reinstalls the game on next Play.")
        edit = ctk.CTkFrame(c, fg_color="transparent")
        edit.pack(fill="x", padx=12)
        state = {"loader": p["loader"]}
        plats = {}

        def pick(l):
            state["loader"] = l
            for n, b in plats.items():
                on = n == l
                b.configure(fg_color=mix(BG, ACCENT, .2) if on else "transparent",
                            border_color=ACCENT if on else LINE, text_color=ACCENT if on else TEXT)

        prow = ctk.CTkFrame(edit, fg_color="transparent")
        prow.pack(anchor="w", pady=(0, 8))
        for l in ("vanilla", "fabric"):
            b = ctk.CTkButton(prow, text=l.title(), width=90, height=32, corner_radius=10, border_width=1,
                              hover_color=LINE, font=(FONT, 13, "bold"), command=lambda l=l: pick(l))
            b.pack(side="left", padx=(0, 6))
            plats[l] = b
        pick(p["loader"])
        ver = ctk.CTkOptionMenu(edit, values=[p["version"]], width=240, height=36, corner_radius=10, fg_color=CARD,
                                button_color=CARD, button_hover_color=LINE, dropdown_fg_color=PANEL,
                                dropdown_hover_color=LINE, text_color=TEXT)
        ver.set(p["version"])
        ver.pack(anchor="w")

        def fill():
            vs = [v["id"] for v in (self._versions or [])] or [p["version"]]
            if ver.winfo_exists():
                ver.configure(values=vs[:60])

        self.load_versions(lambda: self.after(0, fill))

        def save():
            if state["loader"] == "fabric" and self._fabric_versions is not None \
                    and ver.get() not in self._fabric_versions:
                self.say(f"Fabric doesn't support {ver.get()} yet")
                return
            p["loader"], p["version"], p["installed"] = state["loader"], ver.get(), False
            self._save_profiles()
            self.say(f"Saved. {p['name']} will install {p['loader'].title()} {p['version']} on next Play")
            for w in c.winfo_children():
                w.destroy()
            self.iset_install(p, c, d)

        self.btn(edit, "Save changes", save, height=34, width=130).pack(anchor="w", pady=(10, 0))
        self._iset_h(c, "Repair instance", "Re-downloads Minecraft's files on next Play. Try this if the game "
                                           "won't start.")
        self.btn(c, "⚒  Repair", lambda: (p.update(installed=False), self._save_profiles(),
                                          self.say("Game files will be repaired on next Play")),
                 flat=True, height=34, width=110).pack(anchor="w", padx=12)

