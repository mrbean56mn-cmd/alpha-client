# ---------- crash reporting (pythonw has no console, so errors would be invisible) ----------
_LOGDIR = Path.home() / ".alpha"
try:
    _LOGDIR.mkdir(parents=True, exist_ok=True)
    _FAULT = open(_LOGDIR / "fault.log", "w")  # native crashes (e.g. bad Windows API calls) land here
    faulthandler.enable(file=_FAULT, all_threads=True)
except Exception:
    pass


def _report(text, popup=True):
    try:
        with open(_LOGDIR / "crash.log", "a", encoding="utf-8") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S\n") + text + "\n")
    except Exception:
        pass
    if popup:
        try:
            import tkinter as tk
            from tkinter import messagebox
            r = tk.Tk()
            r.withdraw()
            messagebox.showerror("Alpha Client crashed", text[-1400:] + f"\n\nSaved to {_LOGDIR / 'crash.log'}")
            r.destroy()
        except Exception:
            pass


sys.excepthook = lambda t, v, tb: _report("".join(traceback.format_exception(t, v, tb)))
threading.excepthook = lambda a: _report("".join(traceback.format_exception(a.exc_type, a.exc_value, a.exc_traceback)), False)

# ---------- first-run bootstrap ----------
REQUIRED = {"customtkinter": "customtkinter", "minecraft_launcher_lib": "minecraft-launcher-lib",
            "requests": "requests", "PIL": "pillow"}


def bootstrap():
    missing = []
    for mod, pkg in REQUIRED.items():
        try:
            importlib.import_module(mod)
        except ImportError:
            missing.append(pkg)
    if not missing:
        return
    import tkinter as tk
    s = tk.Tk()
    s.title("Alpha Client")
    s.geometry("360x110")
    s.configure(bg="#0B0D10")
    tk.Label(s, text="α  Alpha Client", fg="#3BA7FF", bg="#0B0D10", font=("Segoe UI", 16, "bold")).pack(pady=(18, 4))
    tk.Label(s, text="Setting things up for the first time...", fg="#E6EDF3", bg="#0B0D10").pack()
    s.update()
    r = subprocess.run([sys.executable, "-m", "pip", "install", "--quiet", *missing],
                       creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0), capture_output=True, text=True)
    s.destroy()
    if r.returncode != 0:
        from tkinter import messagebox
        messagebox.showerror("Alpha Client", "Couldn't install dependencies:\n\n" + r.stderr[-600:])
        sys.exit(1)
    importlib.invalidate_caches()


bootstrap()

