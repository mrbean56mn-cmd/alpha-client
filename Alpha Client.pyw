              "show_browse": lambda a: "Browse content", "show_modules": lambda a: "Modules",
              "show_discover": lambda a: "Discover content", "show_screenshots": lambda a: "Screenshots",
              "show_skins": lambda a: "Skin selector"}


def navigable(fn):
    """Records page visits so the top bar's back / forward arrows work."""
    def wrapper(self, *a, **k):
        if not getattr(self, "_navigating", False):
            del self.history[self.hist_i + 1:]
            if not (self.history and self.history[-1] == (fn.__name__, a)):
                self.history.append((fn.__name__, a))
            self.hist_i = len(self.history) - 1
        fn(self, *a, **k)
        self.page_title = NAV_TITLES[fn.__name__](a)
        self.update_nav()
    wrapper.__name__ = fn.__name__
    return wrapper


class Alpha(ctk.CTk):
    def __init__(self):
        ensure_assets()
        try:  # own taskbar identity so Windows shows the Alpha icon, not Python's
            import ctypes
            ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID(APP_ID)
        except Exception:
            pass
        super().__init__()
        self.config_data = load_json(CONFIG_FILE, {})
        self.apply_theme(self.config_data.get("theme", "Dark"), self.config_data.get("accent", "Blue"))
        self.title("Alpha Client")
        self.geometry("1120x780")
        self.minsize(980, 700)
        ico = ICON_FILE

        def set_icon():
            try:
                self.iconbitmap(str(ico))
            except Exception:
                pass

        if ico.exists() and sys.platform == "win32":
            self.after(250, set_icon)
        self.profiles = load_json(PROFILES_FILE, [])
        self.auth = load_json(AUTH_FILE, None)
        self.avatar_cache = {}
        self.icon_cache = {}
        self.pool = ThreadPoolExecutor(4)
        self.selected = None
        self.logo = self.logo_big = self.logo_sm = None
        self.make_logos()
        self.page = None
        self.history, self.hist_i, self._navigating = [], -1, False
        self._versions, self._fabric_versions = None, None
        self.frameless, self.game, self.game_name = False, None, ""
        self._pending_update, self._news = None, None
        self.build_ui()
        if self.config_data.get("frameless"):
            self.after(800, self.go_frameless)
        self.after(2000, self.poll_game)
        if not self.auth:
            self.after(300, self.signin_dialog)
        self.after(1500, self.check_update)
        self.protocol("WM_DELETE_WINDOW", self.on_close)
        self._menu = None
        self.bind("<Button-1>", self.close_menu, add="+")  # clicking anywhere else closes the icon menu
        self.bind("<Escape>", lambda e: self.close_menu(), add="+")

    # ---------- updates ----------
    def check_update(self, manual=False):
        """While Alpha is open, this asks GitHub every minute (in the background, so Alpha never freezes).
        When a new version is pushed it shows "New update ready to download" (a card, a top-bar button and a
        dot on the Downloads icon); nothing restarts until you click Download update. Alpha also installs a
        waiting update when it starts or closes."""
        def work():
            found = find_update()
            try:
                self.after(0, lambda: self._update_checked(found, manual))
            except Exception:
                pass  # Alpha was closed meanwhile

        threading.Thread(target=work, daemon=True).start()

    def _update_checked(self, found, manual=False):
        if found and (not self._pending_update or self._pending_update[0] != found[0]
                      or self._pending_update[1] != found[1]):
            self._pending_update = found
            self.say(f"New update ready to download: Alpha Client {found[0]}")
            self.show_update_ready()
            self.toast("New update ready to download", f"Alpha Client {found[0]} is here. Alpha restarts to "
                       "install it and keeps your instances, settings and account.",
                       "Download update", self.restart_to_update)
        elif not found and self._pending_update:
            self._pending_update = None
            self.show_update_ready()
        if manual:
            self.downloads_dialog()
            if not found:
                self.say(f"Alpha Client {VERSION} is up to date")
        else:
            self.after(60_000, self.check_update)

    def show_update_ready(self):
        """Top-bar button + badge on the Downloads icon while an update is waiting."""
        found = self._pending_update
        try:
            if getattr(self, "upd_btn", None) is not None and self.upd_btn.winfo_exists():
                self.upd_btn.destroy()
            self.upd_btn = None
            if found:
                self.upd_btn = ctk.CTkButton(self.topbar_right, text=" New update ready to download", height=34,
                                             corner_radius=17, fg_color=ACCENT, hover_color=HOVER,
                                             text_color="#07111B", font=(FONT, 13, "bold"),
                                             image=make_icon("download", "#07111B", 15), compound="left",
                                             command=self.downloads_dialog)
                self.upd_btn.pack(side="left", padx=6, before=self.topbar_right.winfo_children()[0])
            if getattr(self, "dl_badge", None) is not None and self.dl_badge.winfo_exists():
                if found or self._busy():
                    self.dl_badge.place(relx=0.78, rely=0.2, anchor="center")
                else:
                    self.dl_badge.place_forget()
        except Exception:
            _report(traceback.format_exc(), popup=False)

    def toast(self, title, text, action=None, command=None, seconds=14):
        """Small card that slides into the bottom-right corner and hides itself."""
        old = getattr(self, "_toast", None)
        if old is not None and old.winfo_exists():
            old.destroy()
        t = self._toast = ctk.CTkFrame(self, fg_color=PANEL, corner_radius=14, border_width=1,
                                       border_color=mix(LINE, ACCENT, .45), width=340)
        head = ctk.CTkFrame(t, fg_color="transparent")
        head.pack(fill="x", padx=16, pady=(14, 2))
        if self.logo_sm:
            ctk.CTkLabel(head, text="", image=ctk.CTkImage(logo_image(TEXT), size=(20, 20))).pack(side="left", padx=(0, 8))
        ctk.CTkLabel(head, text=title, font=(FONT, 14, "bold")).pack(side="left")
        ctk.CTkButton(head, text="✕", width=26, height=26, corner_radius=13, fg_color="transparent", hover_color=LINE,
                      text_color=MUTED, command=t.destroy).pack(side="right")
        ctk.CTkLabel(t, text=text, text_color=MUTED, wraplength=300, justify="left").pack(anchor="w", padx=16)
        if action:
            row = ctk.CTkFrame(t, fg_color="transparent")
            row.pack(fill="x", padx=16, pady=(10, 14))
            self.btn(row, action, lambda: (t.destroy(), command()), height=34).pack(side="left")
            self.btn(row, "Later", t.destroy, flat=True, height=34, width=80).pack(side="left", padx=8)
        else:
            ctk.CTkFrame(t, height=12, fg_color="transparent").pack()
        t.place(relx=1.0, rely=1.0, x=-18, y=-48, anchor="se")
        t.lift()
        self.after(seconds * 1000, lambda: t.winfo_exists() and t.destroy())

    def _busy(self):
        v = self.bar.get() if getattr(self, "bar", None) is not None else 0
        return 0 < v < 1

    def restart_to_update(self):
        found = self._pending_update or find_update()
        if not found:
            self.say(f"Alpha Client {VERSION} is up to date")
            return
        try:
            install_update(found[1])
        except Exception as e:
            _report(traceback.format_exc(), popup=False)
            self.notice("Update failed", str(e))
            return
        self._pending_update = None
        super().destroy()

    def on_close(self):
        """Closing Alpha installs a waiting update quietly, so the next launch is already up to date."""
        found = self._pending_update or find_update(timeout=4)
        if found:
            try:
                install_update(found[1], relaunch=False)
            except Exception:
                _report(traceback.format_exc(), popup=False)
        self.destroy()

    # ---------- top bar (Modrinth-style, replaces the Windows title bar) ----------
    def build_topbar(self):
        bar = self.topbar = ctk.CTkFrame(self, height=54, fg_color=PANEL, corner_radius=0)
        bar.pack(side="top", fill="x")
        bar.pack_propagate(False)
        left = ctk.CTkFrame(bar, fg_color="transparent")
        left.pack(side="left", padx=(14, 0))
        if self.logo_sm:
            ctk.CTkLabel(left, text="", image=self.logo_sm).pack(side="left")
        ctk.CTkLabel(left, text="alpha", font=(FONT, 22, "bold")).pack(side="left", padx=(8, 16))

        def arrow(txt, cmd):
            return ctk.CTkButton(left, text=txt, width=32, height=32, corner_radius=16, fg_color=CARD,
                                 hover_color=LINE, text_color=TEXT, font=(FONT, 18), command=cmd)

        self.nav_back = arrow("‹", lambda: self.nav_step(-1))
        self.nav_back.pack(side="left", padx=3)
        self.nav_fwd = arrow("›", lambda: self.nav_step(1))
        self.nav_fwd.pack(side="left", padx=3)
        self.page_lbl = ctk.CTkLabel(left, text="▷  Home", font=(FONT, 15, "bold"))
        self.page_lbl.pack(side="left", padx=(16, 0))

        right = self.topbar_right = ctk.CTkFrame(bar, fg_color="transparent")
        right.pack(side="right", padx=(0, 6))
        ic = mix(TEXT, BG, .15)
        self.dl_btn = ctk.CTkButton(right, text="", image=make_icon("download", ic, 17), width=38, height=38,
                                    corner_radius=19, fg_color=CARD, border_width=1, border_color=LINE,
                                    hover_color=LINE, command=self.downloads_dialog)
        self.dl_btn.pack(side="left", padx=6)
        self.dl_badge = ctk.CTkFrame(self.dl_btn, width=9, height=9, corner_radius=5, fg_color=ACCENT,
                                     border_width=0, bg_color=CARD)
        pill = self.run_pill = ctk.CTkFrame(right, fg_color=CARD, border_width=1, border_color=LINE, corner_radius=19,
                                            height=38, cursor="hand2")
        pill.pack(side="left", padx=6)
        self.pill_dot = ctk.CTkLabel(pill, text="●", text_color=MUTED, font=(FONT, 10), cursor="hand2")
        self.pill_dot.pack(side="left", padx=(14, 6), pady=6)
        self.pill_txt = ctk.CTkLabel(pill, text="No instances running", font=(FONT, 13), text_color=MUTED,
                                     cursor="hand2")
        self.pill_txt.pack(side="left", padx=(0, 16))
        for w in (pill, self.pill_dot, self.pill_txt):
            w.bind("<Button-1>", lambda e: self.after(10, self.running_menu))
        self.after(50, self.show_update_ready)
        self.winbtns = ctk.CTkFrame(right, fg_color="transparent")
        for kind, cmd, hov in (("min", self.iconify, LINE), ("max", self.toggle_max, LINE), ("close", self.on_close, "#E81123")):
            ctk.CTkButton(self.winbtns, text="", image=make_icon(kind, mix(TEXT, BG, .1), 14), width=46, height=36,
                          corner_radius=8, fg_color="transparent", hover_color=hov, command=cmd).pack(side="left")
        if self.frameless:
            self.winbtns.pack(side="left", padx=(8, 0))
        for w in [bar, left] + [c for c in left.winfo_children() if isinstance(c, ctk.CTkLabel)]:
            w.bind("<ButtonPress-1>", self.start_drag)
            w.bind("<Double-Button-1>", lambda e: self.toggle_max())

    def update_nav(self):
        try:
            self.build_rail()  # keeps the highlighted sidebar button in sync with the page
            self.page_lbl.configure(text="▷  " + getattr(self, "page_title", "Home"))
            self.nav_back.configure(state="normal" if self.hist_i > 0 else "disabled")
            self.nav_fwd.configure(state="normal" if self.hist_i < len(self.history) - 1 else "disabled")
        except Exception:
            pass

    def nav_step(self, d):
        i = self.hist_i + d
        if not 0 <= i < len(self.history):
            return
        self.hist_i = i
        name, args = self.history[i]
        self._navigating = True
        try:
            if args and isinstance(args[0], dict) and args[0] not in self.profiles:
                self.show_home()  # that instance was deleted
            else:
                getattr(self, name)(*args)
        finally:
            self._navigating = False

    def toggle_max(self):
        try:
            self.state("normal" if self.state() == "zoomed" else "zoomed")
        except Exception:
            pass

    def start_drag(self, e):
        if self.frameless:  # hand the drag to Windows: smooth, with edge snapping
            import ctypes
            u = ctypes.windll.user32
            u.ReleaseCapture()
            u.SendMessageW(u.GetParent(self.winfo_id()), 0x00A1, 2, 0)  # WM_NCLBUTTONDOWN, HTCAPTION

    def go_frameless(self):
        """Remove the native title bar but keep resizing, snapping, minimize and the taskbar button."""
        if sys.platform != "win32" or self.frameless:
            return
        try:
            import ctypes
            u = ctypes.windll.user32
            hwnd = u.GetParent(self.winfo_id())
            style = u.GetWindowLongW(hwnd, -16)
            style &= ~0x00C00000                      # WS_CAPTION
            style |= 0x00040000 | 0x00020000 | 0x00010000 | 0x00080000  # THICKFRAME, MINIMIZE/MAXIMIZE BOX, SYSMENU
            u.SetWindowLongW(hwnd, -16, style)
            u.SetWindowPos(hwnd, 0, 0, 0, 0, 0, 0x0027)  # NOMOVE | NOSIZE | NOZORDER | FRAMECHANGED
            self.frameless = True
            if self.winbtns.winfo_exists():
                self.winbtns.pack(side="left", padx=(8, 0))
        except Exception:
            self.frameless = False

    def poll_game(self):
        g = getattr(self, "game", None)
        running = g is not None and g.poll() is None
        gp = getattr(self, "game_profile", None)
        if gp is not None:  # count play time while the game is open
            now = time.time()
            gp["playtime"] = gp.get("playtime", 0) + (now - self._tick)
            self._tick = now
            if not running or now - getattr(self, "_saved_at", 0) > 60:
                if not running:
                    gp["last_played"] = now
                    self.game_profile = None
                    post, cwd, env = getattr(self, "_post_hook", (None, None, None))
                    if post:  # post-exit launch hook
                        subprocess.Popen(post, shell=True, cwd=cwd, env=env,
                                         creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
                self._saved_at = now
                save_json(PROFILES_FILE, self.profiles)
        try:
            self.pill_dot.configure(text_color="#1BD96A" if running else MUTED)
            self.pill_txt.configure(text=f"{short(self.game_name, 22)}  ·  running" if running else "No instances running",
                                    text_color=TEXT if running else MUTED)
            self.run_pill.configure(border_color=mix(LINE, "#1BD96A", .45) if running else LINE)
            self.show_update_ready()
        except Exception:
            pass
        self.after(2000, self.poll_game)

    def running_menu(self):
        g = getattr(self, "game", None)
        if g is None or g.poll() is not None:
            self.say("No instances running. Press Play on an instance to start one.")
            return

        def stop():
            try:
                g.terminate()
                self.say(f"Stopped {self.game_name}")
            except Exception as e:
                self.say(f"Couldn't stop the game: {e}")

        p = getattr(self, "game_profile", None)
        items = [("trash", "Stop game", stop)]
        if p is not None:
            items.insert(0, ("cube", f"Open {short(p['name'], 18)}", lambda: self.show_instance(p)))
            items.insert(1, ("download", "Open game folder", lambda: self.open_folder(p)))
        self.popup_menu(self.run_pill, items)

