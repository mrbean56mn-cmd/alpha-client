    # ---------- helpers ----------
    def btn(self, parent, text, cmd, flat=False, **kw):
        return ctk.CTkButton(parent, text=text, command=cmd, corner_radius=10, font=(FONT, 13, "bold"),
                             fg_color=CARD if flat else ACCENT, hover_color=LINE if flat else HOVER,
                             text_color=TEXT if flat else "#07111B", **kw)

    def modal(self, d):
        d.transient(self)

        def go():
            try:
                if d.winfo_exists():
                    d.lift()
                    d.focus_force()
                    d.grab_set()
            except Exception:
                pass

        d.after(250, go)

    def say(self, text):
        acts = self.__dict__.setdefault("activity", [])
        if not acts or acts[-1][1] != text:
            acts.append((time.time(), text))
            del acts[:-30]
        self.after(0, lambda: self.status.configure(text=text))

    def progress(self, v):
        self.after(0, lambda: self.bar.set(v))

    def new_page(self, scroll=False):
        if self.page:
            self.page.destroy()
        cls = ctk.CTkScrollableFrame if scroll else ctk.CTkFrame
        self.page = cls(self.center, fg_color=BG)
        self.page.pack(fill="both", expand=True)
        return self.page

    def icon_image(self, p, size):
        """CTkImage of the instance's custom icon, or None when it uses the default letter tile."""
        spec = p.get("icon")
        if not spec:
            return None
        im = render_icon(spec, size * 2, self.game_dir(p))
        return ctk.CTkImage(light_image=im, dark_image=im, size=(size, size)) if im else None

    def icon(self, parent, p, size=48):
        img = self.icon_image(p, size)
        if img:
            return ctk.CTkLabel(parent, text="", image=img, width=size, height=size)
        color = ICONS[int(p["id"], 16) % len(ICONS)]
        f = ctk.CTkFrame(parent, width=size, height=size, fg_color=color, corner_radius=size // 4)
        f.pack_propagate(False)
        ctk.CTkLabel(f, text=p["name"][:1].upper(), font=(FONT, size // 2, "bold"), text_color="white").pack(expand=True)
        return f

    def game_dir(self, p):
        return ROOT / "profiles" / p["id"]

