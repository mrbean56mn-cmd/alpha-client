                            text_color=MUTED, font=(FONT, 12), wraplength=400, justify="left")

        # recent activity
        ctk.CTkLabel(body, text="RECENT ACTIVITY", font=(FONT, 11, "bold"), text_color=MUTED).pack(anchor="w", pady=(20, 6))
        recent = ctk.CTkFrame(body, fg_color="transparent")
        recent.pack(fill="x")
        acts = [a for a in getattr(self, "activity", []) if a[1] != "Ready"][-5:][::-1]
        if not acts:
            ctk.CTkLabel(recent, text="Nothing yet.", text_color=MUTED, font=(FONT, 12)).pack(anchor="w")
        for ts, msg in acts:
            r = ctk.CTkFrame(recent, fg_color="transparent")
            r.pack(fill="x", pady=1)
            ctk.CTkLabel(r, text=time.strftime("%H:%M", time.localtime(ts)), text_color=MUTED,
                         font=("Consolas", 11), width=44, anchor="w").pack(side="left")
            ctk.CTkLabel(r, text=short(msg, 60), font=(FONT, 12), anchor="w").pack(side="left")

        def refresh():
            if not d.winfo_exists():
                return
            v, text = self.bar.get(), self.status.cget("text")
            busy = 0 < v < 1
            st.configure(text=text if busy else "Nothing downloading", text_color=TEXT if busy else MUTED)
            pct.configure(text=f"{int(v * 100)}%" if busy else "")
            if busy:
                idle.pack_forget()
                bar.pack(fill="x", padx=16, pady=(0, 16))
                bar.set(v)
            else:
                bar.pack_forget()
                idle.pack(anchor="w", padx=16, pady=(0, 14))
            d.after(400, refresh)

        refresh()

