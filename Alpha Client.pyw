    def page_resources(self, c):
        self.sh(c, "Storage", "Everything Alpha downloads lives in one folder.")
        lab = ctk.CTkLabel(c, text="Calculating…", text_color=MUTED)
        lab.pack(anchor="w", padx=24)

        def calc():
            total = 0
            for dp, _, files in os.walk(ROOT):
                for f in files:
                    try:
                        total += os.path.getsize(os.path.join(dp, f))
                    except OSError:
                        pass
            self.after(0, lambda: lab.winfo_exists() and lab.configure(text=f"{total / 1e9:.2f} GB used in {ROOT}"))

        threading.Thread(target=calc, daemon=True).start()
        row = ctk.CTkFrame(c, fg_color="transparent")
        row.pack(anchor="w", padx=24, pady=12)
        self.btn(row, "Open Alpha folder", lambda: os.startfile(ROOT) if sys.platform == "win32"
                 else webbrowser.open(ROOT.as_uri()), width=160).pack(side="left", padx=(0, 8))
        self.btn(row, "Clear download cache", lambda: (shutil.rmtree(ROOT / "tmp", ignore_errors=True),
                                                       self.say("Download cache cleared")), flat=True, width=170).pack(side="left")

