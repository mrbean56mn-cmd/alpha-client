    # -- row helpers --
    def sh(self, c, title, desc=""):
        ctk.CTkLabel(c, text=title, font=(FONT, 20, "bold")).pack(anchor="w", padx=24, pady=(20, 2))
        if desc:
            ctk.CTkLabel(c, text=desc, text_color=MUTED, justify="left", wraplength=560).pack(anchor="w", padx=24, pady=(0, 10))

    def toggle_row(self, c, title, desc, key, default=False):
        row = ctk.CTkFrame(c, fg_color="transparent")
        row.pack(fill="x", padx=24, pady=10)
        tx = ctk.CTkFrame(row, fg_color="transparent")
        tx.pack(side="left", fill="x", expand=True)
        ctk.CTkLabel(tx, text=title, font=(FONT, 15, "bold")).pack(anchor="w")
        ctk.CTkLabel(tx, text=desc, text_color=MUTED, justify="left", wraplength=440).pack(anchor="w")
        sw = ctk.CTkSwitch(row, text="", width=46, progress_color=ACCENT)
        if self.config_data.get(key, default):
            sw.select()

        def save():
            self.config_data[key] = bool(sw.get())
            self.save_cfg()

        sw.configure(command=save)
        sw.pack(side="right")

    def entry_row(self, c, title, desc, key, placeholder="", width=420):
        ctk.CTkLabel(c, text=title, font=(FONT, 15, "bold")).pack(anchor="w", padx=24, pady=(14, 0))
        ctk.CTkLabel(c, text=desc, text_color=MUTED, justify="left", wraplength=560).pack(anchor="w", padx=24, pady=(0, 6))
        e = ctk.CTkEntry(c, width=width, fg_color=CARD, border_color=LINE, placeholder_text=placeholder)
        if self.config_data.get(key):
            e.insert(0, str(self.config_data[key]))
        e.pack(anchor="w", padx=24)

        def save(_=None):
            v = e.get().strip()
            if v:
                self.config_data[key] = v
            else:
                self.config_data.pop(key, None)
            self.save_cfg()

        e.bind("<Return>", save)
        e.bind("<FocusOut>", save)

