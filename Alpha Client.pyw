        ctk.CTkLabel(pg, text="Screenshots", font=(FONT, 26, "bold")).pack(anchor="w", padx=20, pady=(18, 8))
        bar = ctk.CTkFrame(pg, fg_color="transparent")
        bar.pack(fill="x", padx=20, pady=(0, 6))
        box = ctk.CTkFrame(bar, fg_color=CARD, corner_radius=10, border_width=1, border_color=LINE, height=40)
        box.pack(side="left", fill="x", expand=True)
        box.pack_propagate(False)
        ctk.CTkLabel(box, text="", image=make_icon("search", MUTED, 16)).pack(side="left", padx=(12, 4))
        self.sq = ctk.CTkEntry(box, placeholder_text="Search screenshots…", height=34, fg_color=CARD, border_width=0)
        self.sq.pack(side="left", fill="x", expand=True, padx=(0, 6))
